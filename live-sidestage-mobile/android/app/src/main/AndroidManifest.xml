<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!--
      dataSync は意図的に外している。Android 15 以降、dataSync 型の
      foreground service は24時間あたり合計6時間でタイムアウトする。
      配信の待受は6時間を超えうるので、これに当たると読み上げも効果音も
      途中で止まってしまう。

      このサービスの実体はコメント読み上げ(VOICEVOX)と効果音の再生なので、
      mediaPlayback 単独で用途としても正しい。mediaPlayback はタイムアウト対象外。
      Play Console では foreground service の用途説明が必要になる。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <application
        android:label="Live Sidestage"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--
          Sign in with Apple の戻り先。
          Android にはネイティブの Apple 認証が無いので Custom Tab で Apple のページを開き、
          Apple → 自前サーバーの中継(/api/mobile/auth/apple/callback) → このスキーム
          という順で戻ってくる。scheme / path は sign_in_with_apple パッケージの規定値で、
          サーバー側が組み立てる intent URI
          (intent://callback?...#Intent;package=...;scheme=signinwithapple;end) と対になっている。

          exported="true" が要る(ブラウザからの遷移を受けるため)。裏を返すと
          **他のアプリからも叩ける**ので、認証結果は端末側で state を、サーバー側で
          nonce と authorization code を検証している。
        -->
        <activity
            android:name="com.aboutyou.dart_packages.sign_in_with_apple.SignInWithAppleCallback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="signinwithapple" />
                <data android:path="callback" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 効果音ラボ / MyInstants のサイトを外部ブラウザで開く(url_launcher)。
             Android 11 以降のパッケージ可視性制限により、この宣言が無いと
             ブラウザを解決できず launchUrl が失敗する。 -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
