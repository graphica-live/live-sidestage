<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter の hot reload / DevTools 用。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      debug ビルドでのみ平文HTTPを許可する。ローカルの analytics
      (`npm run dev:local` + `adb reverse tcp:3000 tcp:3000`) へ
      `--dart-define=API_BASE_URL=http://localhost:3000` で向けるため。
      release マニフェストには入れないので、本番APKは HTTPS のみのまま。
    -->
    <application android:usesCleartextTraffic="true" />
</manifest>
