DATABASE_URL="postgresql://user:password@host:5432/liveanalytics"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-app.railway.app"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# モバイルアプリ(TikCaptionReader等)の会員登録/ログインAPIが発行するJWTの署名用シークレット
MOBILE_JWT_SECRET="generate-with-openssl-rand-base64-32"

# --- TikTok接続のIP分散 / Worker分割 ---

# Webプロセス・Workerプロセス共通。部屋(TiktokRoom)のworkerId割当(hash(roomId) % WORKER_COUNT)を
# 計算するために使う。Webも resolveWorkerForRoom() を呼ぶので、Web側にも必ず設定すること。
# イベント集計ワーカー(event-worker.ts)は接続を持たないため不要。
#
# Worker Serviceを増やす手順(この順序で行う):
#   1. 新しいWorker Serviceを WORKER_COUNT=<新しい値> / WORKER_INDEX=1,2,... で作成し、
#      /healthz が200になるまで待つ。既存部屋のworkerIdは旧値のまま永続化されているので、
#      この時点では新Workerは何も担当せず、待機するだけで既存の接続に影響しない。
#   2. Webと既存Workerの WORKER_COUNT を <新しい値> に揃えて再デプロイする
#   3. 全プロセスが上がってから WORKER_COUNT=<新しい値> node scripts/rebalance-workers.js --apply
#
# 1より先に2をやってはいけない。Webが新しいWORKER_COUNTで新規部屋のworkerIdを決めるため、
# まだ存在しないWorker宛の部屋が生まれ、その部屋は誰にも接続されないまま残る。
# 3を省くと既存部屋のworkerIdは永続化された旧値のままなので、新Workerには新規部屋しか回らない。
# rebalanceは担当替えで一斉再接続(reconnect storm)を起こすため、視聴の少ない時間帯に実行する。
#
# 減らす場合は逆順にする。先に WORKER_COUNT を下げて rebalance --apply で担当を移し、
# 担当が空になったWorker Serviceを最後に削除する。
#
# worker-guardian.ts(下記)もこの手順の影響を受ける。過渡状態(URL数とWORKER_COUNTが
# 一時的に食い違う等)で誤った自動移送をしないよう、作業前に AppSetting の
# workerGuardianDisabled を "true" にしてguardianを黙らせ、作業完了後に戻すこと。
WORKER_COUNT="1"

# Workerプロセス(worker.ts)専用。自分がどの担当番号か(0-indexed, [0, WORKER_COUNT)の範囲)。
# Webプロセスには設定しない。
WORKER_INDEX="0"

# Workerプロセス専用。Webプロセスの内部エンドポイント(Railway private networkingのホスト名)。
# 未設定ならWeb/Workerを1プロセスで動かしている扱いになり、in-process直接呼び出しにフォールバックする。
WEB_INTERNAL_URL="http://web.railway.internal:3000"

# Web・Worker共通。Worker→Webの内部API(/api/internal/gift-event)と、
# Web→Workerの診断API(GET /status)の両方を保護する共有シークレット。
INTERNAL_API_SECRET="generate-with-openssl-rand-base64-32"

# Webプロセス専用。管理画面 /admin/workers が各Workerの GET /status を叩くための内部URL。
# JSON配列で、**WORKER_INDEX の順に並べる**(0番目の要素が WORKER_INDEX=0 のWorker)。
# 未設定なら管理画面はDB上の担当割当だけを表示し、各Workerは「応答なし」になる。
# Railwayでは各Worker Serviceの RAILWAY_PRIVATE_DOMAIN + healthcheckのポート(既定8080)。
WORKER_INTERNAL_URLS='["http://worker1.railway.internal:8080","http://worker2.railway.internal:8080","http://worker3.railway.internal:8080"]'

# Workerプロセスはデプロイ時のゼロダウンタイム切替のため GET /healthz を公開する
# (未接続=503, resumeAllListeners()完了後=200)。RailwayがPORTを注入しない場合は8080を使う。
# 各Worker Serviceのダッシュボード設定で以下を行うこと:
#   - Healthcheck Path: /healthz (担当streamer数に応じてタイムアウトを調整)
#   - RAILWAY_DEPLOYMENT_DRAINING_SECONDS: 旧Workerの全接続切断が終わる程度(目安15〜20)
#   - RAILWAY_DEPLOYMENT_OVERLAP_SECONDS: ready後の追加安全バッファ(目安5〜10)
#
# overlap中は新旧2つのWorkerが同じ部屋に接続する。ギフトのロストを防ぐためだが、
# **保存側が「同じイベントを2回受けても結果が変わらない」ことが前提**になる。
# 現在それを担保しているのは:
#   - non-combo: msgIdの2層dedup(プロセス内FIFO + 直近5分の(roomId, msgId)照会)
#   - combo:     saveComboGift()がDBの確定値からdeltaを計算する(advisory lock下)
# この前提を崩す変更(dedupやdelta計算の方式変更)を入れるときは、
# **そのデプロイに限り overlap を 0 にして新旧を並走させないこと。**
# 旧コードは新しい取り決めを知らないので、片側だけ直しても競合が残る。
#   1. 全Worker Serviceの RAILWAY_DEPLOYMENT_OVERLAP_SECONDS を 0 にする(--skip-deploys付き)
#   2. デプロイする(旧が完全停止してから新が起動する)
#   3. /admin/workers で全Workerがready・担当部屋がconnectedになったことを確認する
#   4. 値を戻す(--skip-deploys付き。次のデプロイから復帰する)
# 切替の数秒〜十数秒は接続が空くので、可能なら監視中の部屋が配信していない時間帯に行う。

# プロキシプール(住宅/モバイル系sticky sessionプロキシのURL配列, JSON形式)。
# 空/未設定ならプロキシなしで直結する。新しいプロキシは配列の末尾に追加すること
# (途中への挿入・削除は既存のsticky割当をずらしてしまう)。
TIKTOK_PROXY_POOL="[]"

# --- Worker死活監視の自動移送(worker-guardian.ts) ---
# TikTok接続を維持する worker.ts / event-worker.ts とは別サービスとしてデプロイする。
# start command を `npm run worker-guardian` に変える以外は、Webと同じイメージでよい。
# 必須なのは DATABASE_URL / INTERNAL_API_SECRET / WORKER_COUNT / WORKER_INTERNAL_URLS
# (いずれもWeb/Workerと共有する既存の値をそのまま使う。新規必須変数はない)。
#
# 監視対象workerが「割当済み監視部屋が1件以上あり、その全部でwatchdogが再接続バックオフの
# 上限(10分)に達した」状態が連続でこの回数続いたら死亡と判定し、部屋を生きてるworkerへ移す。
# 部屋のstatus(retrying等)そのものは判定に使わない — 配信者オフライン中のretryingは
# 何時間でも続く正常状態のため。
WORKER_GUARDIAN_POLL_INTERVAL_MS="30000"
WORKER_GUARDIAN_BAD_POLLS_REQUIRED="6"

# 移送を実行してからこの時間内は、新たな死亡確定があっても移送を実行しない
# (移送先も詰まって連鎖的に移送し続ける「ローリング連鎖」を防ぐブレーキ)。
WORKER_GUARDIAN_COOLDOWN_MS="900000"

# --- イベント公開ページの配信者アイコン(web) ---
# /api/public/avatar/<participantId> が TikTok から取得して CDN へ302で送る。
# URLは署名付きで約47時間で失効するため保存せず、プロセス内キャッシュだけで扱う。
# TikTok側の仕様変更やレート制限で不具合が出たときに、"1" で取得を全面停止できる
# (アイコンはプレースホルダになるだけで、表そのものは動く)。
# TIKTOK_AVATAR_DISABLED="1"

# --- イベント集計ワーカー(event-worker.ts) ---
# TikTok接続を維持する worker.ts とは別サービスとしてデプロイする。
# 集計が詰まってもWebcastのWebSocketを巻き込まないようにするため。
# start command を `npm run event-worker` に変える以外は、Webと同じイメージでよい。
# 必須なのは DATABASE_URL だけ(以下はどちらも省略可)。

# 開催中イベントを再集計する間隔。SLOは1周10秒。
AGGREGATE_INTERVAL_MS="10000"

# 監視期限(TiktokRoom.monitorUntil)の延長を確認する間隔。
# 切り詰めが起きるのは終了が120日以上先のイベントだけなので、集計ほど頻繁でなくてよい。
LEASE_RENEW_INTERVAL_MS="3600000"
