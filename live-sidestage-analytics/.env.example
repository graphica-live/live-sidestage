DATABASE_URL="postgresql://user:password@host:5432/liveanalytics"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-app.railway.app"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# モバイルアプリ(TikCaptionReader等)の会員登録/ログインAPIが発行するJWTの署名用シークレット
MOBILE_JWT_SECRET="generate-with-openssl-rand-base64-32"

# --- TikTok接続のIP分散 / Worker分割 ---

# Webプロセス・Workerプロセス共通。配信者のworkerId割当(hash(streamerId) % WORKER_COUNT)を計算するために使う。
# Worker Serviceの数を変えたら、全プロセスでこの値を揃えてから scripts/rebalance-workers.js --apply を実行すること。
WORKER_COUNT="1"

# Workerプロセス(worker.ts)専用。自分がどの担当番号か(0-indexed, [0, WORKER_COUNT)の範囲)。
# Webプロセスには設定しない。
WORKER_INDEX="0"

# Workerプロセス専用。Webプロセスの内部エンドポイント(Railway private networkingのホスト名)。
# 未設定ならWeb/Workerを1プロセスで動かしている扱いになり、in-process直接呼び出しにフォールバックする。
WEB_INTERNAL_URL="http://web.railway.internal:3000"

# Web・Worker共通。Worker→Webの内部API(/api/internal/gift-event)を保護する共有シークレット。
INTERNAL_API_SECRET="generate-with-openssl-rand-base64-32"

# Workerプロセスはデプロイ時のゼロダウンタイム切替のため GET /healthz を公開する
# (未接続=503, resumeAllListeners()完了後=200)。RailwayがPORTを注入しない場合は8080を使う。
# 各Worker Serviceのダッシュボード設定で以下を行うこと:
#   - Healthcheck Path: /healthz (担当streamer数に応じてタイムアウトを調整)
#   - RAILWAY_DEPLOYMENT_DRAINING_SECONDS: 旧Workerの全接続切断が終わる程度(目安15〜20)
#   - RAILWAY_DEPLOYMENT_OVERLAP_SECONDS: ready後の追加安全バッファ(目安5〜10)

# プロキシプール(住宅/モバイル系sticky sessionプロキシのURL配列, JSON形式)。
# 空/未設定ならプロキシなしで直結する。新しいプロキシは配列の末尾に追加すること
# (途中への挿入・削除は既存のsticky割当をずらしてしまう)。
TIKTOK_PROXY_POOL="[]"

# --- イベント集計ワーカー(event-worker.ts) ---
# TikTok接続を維持する worker.ts とは別サービスとしてデプロイする。
# 集計が詰まってもWebcastのWebSocketを巻き込まないようにするため。
# start command を `npm run event-worker` に変える以外は、Webと同じイメージでよい。
# 必須なのは DATABASE_URL だけ(以下はどちらも省略可)。

# 開催中イベントを再集計する間隔。SLOは1周10秒。
AGGREGATE_INTERVAL_MS="10000"

# 監視期限(TiktokRoom.monitorUntil)の延長を確認する間隔。
# 切り詰めが起きるのは終了が120日以上先のイベントだけなので、集計ほど頻繁でなくてよい。
LEASE_RENEW_INTERVAL_MS="3600000"
