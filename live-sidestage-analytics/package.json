{
  "name": "live-analytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "worker": "tsx worker.ts",
    "build": "prisma generate && prisma db push --accept-data-loss && next build",
    "start": "node server.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "rebalance-workers": "node scripts/rebalance-workers.js",
    "dev:local": "dotenv -e .env.local.test -- node server.js",
    "db:push:local": "dotenv -e .env.local.test -- prisma db push",
    "seed:local": "dotenv -e .env.local.test -- tsx prisma/seed-local.ts",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "dotenv -e .env.local.test -- vitest run integration",
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "next": "^14.2.0",
    "next-auth": "^4.24.11",
    "proxy-agent": "^6.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tiktok-live-connector": "^2.1.1-beta1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.12",
    "typescript": "^5.5.2",
    "vitest": "^4.1.10"
  }
}
