generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

// **このファイルが public / event 両スキーマの唯一の正。**
//
// 以前は event を別プロジェクト・別 Prisma にしていたが、そちらの schemas に public を
// 足すと、向こうに書いていない gifts / TiktokRoom / Streamer が
// `db push --accept-data-loss` の削除差分になるという事故が起きうる構造だった。
// 1つの schema.prisma が両方を書くことで、その危険が構造的に消える。
//
// スキーマを分けたままにしているのは、テーブルの役割が違うため(public = TikTok の受信データと
// 認証、event = イベント運営)。ロールによる権限分割は行っていない。
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "event"]
}

// ============================================================================
// public — TikTok Live の受信データと認証
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  streamer Streamer?

  @@schema("public")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("public")
}

// 1つのTikTokアカウント(tiktokId)につき1本のTikTok Live接続を共有するための実体。
// 複数のStreamer行(=複数ユーザー)が同じtiktokIdを登録した場合、全員がこのTiktokRoomを
// 経由して同じ接続・同じGiftデータを参照する(接続リソースの重複と、orderIdユニーク制約
// 違反によるギフト取りこぼしを防ぐため)。
model TiktokRoom {
  id                String    @id @default(cuid())
  tiktokId          String    @unique // 正規化済み(小文字化・trim・先頭@除去)
  deviceId          String?
  workerId          Int?     // 担当Workerプロセス番号(hash(roomId) % WORKER_COUNTで初回決定し固定)
  proxyKey          String?  // TIKTOK_PROXY_POOL内のインデックス(sticky割当、egress IP分散用)
  listenerStatus    String?
  listenerMessage   String?
  listenerUpdatedAt DateTime?
  // イベント(event スキーマ側)が期限付きで監視を要求している場合の期限。
  // これが未来の間は、Streamerが1人もいなくてもWorkerが接続を維持する(getMyRooms参照)。
  // 期限切れ後は次のreconcileで切断されるが、受信済みのGiftはそのまま残る。
  monitorUntil      DateTime?
  createdAt         DateTime  @default(now())

  // --- TikTok非実在Streamer自動削除(tiktok-room-cleanup.ts)用 ---
  // listenerStatusがretrying/errorに入った最初の時刻。connectedに戻ったらnullに戻す。
  // "connecting"遷移では絶対に触らない(再接続試行のたびに数十秒間隔で走るため、
  // ここでリセットすると不健全継続時間が永久にゼロへ巻き戻ってしまう)。
  // 書き込みはpersistState()(tiktok-listener.ts)に一本化する。
  unhealthySince       DateTime?
  // fetchTiktokProfile()がNOT_FOUNDを連続で返した回数。ok:trueで確定的に0へリセットする。
  // RATE_LIMITED/ERRORでは増減しない(判定不能として無視。TikTok側の一時的なレート制限が
  // 続く間は永久に連続回数を達成できなくなる自己矛盾を避けるため)。
  notFoundStreak       Int       @default(0)
  // 上記ストリークの初回NOT_FOUND検出時刻。ストリークが0に戻ったらnullに戻す。
  notFoundFirstAt      DateTime?
  // このRoomに対しfetchTiktokProfile()を最後に実行した時刻(結果を問わず)。
  // 同じ部屋への過度な再チェックを防ぐクールダウンと、候補選定の公平なローテーションに使う。
  lastExistenceCheckAt DateTime?

  streamers Streamer[]
  gifts     Gift[]
  battles   TiktokBattle[]
  watches   AgencyWatch[]

  // getMyRooms()の「担当workerId かつ (購読者あり または monitorUntilが未来)」検索用。
  // 期限切れの監視要求が蓄積しても60秒ごとのreconcileが重くならないようにする。
  @@index([workerId, monitorUntil])
  // tiktok-room-cleanup.tsの候補抽出クエリ用(listenerStatus + unhealthySince の複合条件)。
  @@index([listenerStatus, unhealthySince])
  @@schema("public")
}

// 事務所・企業向けのアカウント。配信者本人(Streamer)とは独立していて、
// 自分ではTikTok IDを持たず、監視対象(AgencyWatch)を通してのみデータを参照する。
//
// Userではなくemailを識別子にしている。管理者が相手のGoogleアカウントのメールアドレスを
// 先に登録し、本人がそのアカウントでログインした時点で使えるようにするため
// (ログイン前はUser行が存在しないので、userIdでは紐づけられない)。
// 事務所が存在すること自体が利用許可であり、別途の承認フラグは持たない。
model Agency {
  id              String   @id @default(cuid())
  email           String   @unique // 管理者が登録したGoogleアカウント。小文字に正規化して保存する
  name            String
  // 企業向けAPIキーはSHA-256ハッシュで保存する(Streamer.apiKeyの平文保存は踏襲しない)。
  // 参照は常にキー本体のハッシュで引くため、平文を持たなくても認証できる。
  apiKeyHash      String?  @unique
  maxWatchTargets Int      @default(10) // 監視対象の上限。1件ごとにTikTok接続とproxy枠を消費するため必須
  createdAt       DateTime @default(now())

  watches AgencyWatch[]

  @@schema("public")
}

// 事務所が監視対象に指定したライバー。ギフトデータはTiktokRoom単位で共有されるため
// roomIdで紐づける(Streamerと同じ設計)。tiktokIdは事務所の入力値そのままを表示用に保持し、
// 正規化済みの値はTiktokRoom側だけが単一の正として持つ。
// 配信者本人の登録(Streamer)は必要なく、Streamerが0人でもwatchがあればWorkerが接続する。
model AgencyWatch {
  id        String   @id @default(cuid())
  agencyId  String
  roomId    String
  tiktokId  String   // 表示用。ユーザー入力値そのまま
  label     String?  // 事務所側の管理名(本名・所属チームなど)
  createdAt DateTime @default(now())

  agency Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  room   TiktokRoom @relation(fields: [roomId], references: [id])

  @@unique([agencyId, roomId])
  @@index([roomId])
  @@schema("public")
}

model Streamer {
  id               String    @id @default(cuid())
  userId           String    @unique
  tiktokId         String    // 表示用。ユーザー入力値そのまま(正規化はTiktokRoom側でのみ行う)
  verificationCode String
  verified         Boolean   @default(false)
  verifiedAt       DateTime?
  apiKey           String?   @unique
  createdAt        DateTime  @default(now())
  roomId           String?   // 実際の接続・ギフトデータを共有するTiktokRoomへの紐付け

  overlayToken            String? @unique
  overlayDisplayReference String  @default("today") // "today" | "fixed"
  overlayDisplayDate      String? // YYYY-MM-DD, overlayDisplayReference="fixed" のときのみ意味を持つ
  overlayThreshold        Int     @default(1000)
  overlayGoalCount        Int     @default(5)
  overlayVisibleRows      Int     @default(5) // この人数を超えたらスナップスクロール
  overlayNameMaxWidth     Int     @default(140) // px、これを超える名前は省略表示
  overlayAlign            String  @default("left") // "left" | "right"
  overlayHeadingBackground String @default("clear") // "clear" | "crystal-blue" | "sakura-pink"
  overlayDisplaySpeed     Int     @default(3) // 1(遅い)〜5(速い)、スナップスクロールと全体縮小表示の待機時間を制御

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      TiktokRoom? @relation(fields: [roomId], references: [id])
  giftEdits GiftEdit[]

  @@index([roomId])
  @@schema("public")
}

model AppSetting {
  key       String   @id
  value     String?  @db.Text
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model Gift {
  id              String   @id @default(cuid())
  roomId          String   // TikTokアカウント単位で共有(同じtiktokIdを登録した全ユーザーが同じ行を参照)
  uniqueId        String
  nickname        String
  profileImageUrl String?
  giftId          Int
  giftName        String
  giftPictureUrl  String?
  repeatCount     Int      @default(1)
  diamondCount    Int      @default(0)
  totalDiamonds   Int      @default(0)
  receivedAt      DateTime @default(now())
  timeSource      String   @default("tiktok") // "tiktok" | "fallback" — fallback は TikTok createTime 欠落/不正でサーバー受信時刻を使用したことを示す
  dayKey          String
  orderId         String?
  groupId         String?
  // TikTok common.msgId。protobufの既定値"0"等、実IDとして使えない値は resolveMsgId() が null にする。
  // dedupキー。saveGift() が「直近5分に同じ (roomId, msgId) があるか」を引くのに使う
  // (@@index([roomId, msgId]))。**unique制約は張らない** — roomIdは配信セッション
  // ではなく永続的なTiktokRoom.idなので、将来の別ライブでmsgIdが再利用されたら正当なギフトを
  // 恒久的に弾いてしまう。加えて prisma db push は Dockerfile の CMD でコンテナ起動時に走るため、
  // 既存の重複行があるとunique index作成に失敗してWebが起動しなくなる。
  msgId           String?
  // 1 = combo可能ギフト。groupId="0" が3591件流入していて、それが実際にcomboなのか
  // 単発ギフトなのかを本番DBだけでは判定できないため、combo キーの設計見直し用に残す。
  giftType        Int?

  room  TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  edits GiftEdit[]

  @@map("gifts")
  @@unique([roomId, orderId])
  @@index([roomId, dayKey])
  @@index([roomId, receivedAt])
  @@index([roomId, uniqueId])
  @@index([roomId, groupId])
  @@index([roomId, msgId])
  @@schema("public")
}

// TikTokから受信したオリジナルのGiftは変更・削除しない。編集内容はここに別レコードとして保持し、
// 表示時のみ上書きする(オリジナルデータのみでの集計を別途可能にするため)。
// Giftはtiktokアカウント単位で共有されるため、編集/非表示はstreamerId単位に紐づけ、
// 編集した本人にしか見えないようにする(他の登録者のデータには影響しない)。
model GiftEdit {
  id            String   @id @default(cuid())
  giftId        String
  streamerId    String
  giftName      String
  totalDiamonds Int
  hidden        Boolean  @default(false) // trueの場合、この行を編集したstreamerの集計・履歴からのみ除外する
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gift     Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("gift_edits")
  @@unique([giftId, streamerId])
  @@schema("public")
}

// TikTokの全ギフトカタログ(webcastの `gift/list/` の結果)。全部屋で共有する1枚のテーブル。
// ギフトはほぼグローバルなので部屋ごとには持たない(部屋限定ギフトは和集合として混ざる)。
//
// **効果音の一致キーはgiftIdではなく名前。** gift/list/ は同じ名前に複数のgiftIdを割り当てており
// (実測670件中29名が重複)、giftId自体もレスポンス内で重複する(実測4行)。giftId照合にすると
// 同名の別IDを取りこぼすうえ、ピッカーに区別のつかない同名行が並ぶ。
// giftIdを主キーにしているのはカタログを素直な鏡として持つためだけで、
// 消費側(GET /api/mobile/gifts)は name で畳んでコイン数の範囲に集約して返す。
//
// upsertのみで削除はしない。したがって実体は「現在のカタログ」ではなく
// **「これまでに観測したカタログの和集合」**になる。候補一覧を出すのが目的なので意図的にそうしている
// (TikTok側のA/Bやproxyの地域差で一時的に欠けたギフトを消したくない)。
model TiktokGiftCatalog {
  giftId       Int      @id // gift/list/ の gift.id
  name         String // 一致キー。trim + 小文字化済み(chat:giftのgiftNameと同じ正規化)
  label        String // 表示用。カタログの元表記
  diamondCount Int      @default(0)
  fetchedAt    DateTime @default(now()) // 最後にカタログから見た時刻。TTL判定に使う。**upsert時に明示更新する**

  @@map("tiktok_gift_catalog")
  @@index([name])
  @@schema("public")
}

// TikTokのバトル(LinkMic Battle)の観測記録。イベントの対戦自動検知が使う。
// analytics自身はこのデータを使わないが、バトル中かどうかはWebcastのイベントでしか
// 分からないので受信側で残しておく。
//
// **1つのバトルについて、参加した両サイドのroomからそれぞれ同じbattleIdのイベントが届く。**
// (両方をこちらが監視している場合)。したがってbattleIdでグループ化すれば
// 「そのバトルに誰が参加したか」がpayloadの解釈精度に依存せず分かる。
// 相手のTikTokハンドル(uniqueId)はpayloadに含まれないため、この照合が唯一の確実な手段。
model TiktokBattle {
  id       String @id @default(cuid())
  roomId   String
  battleId String // TikTokのbattleId。API上stringなので数値化しない
  action   Int // 最後に観測したBattleAction(OPEN=4 / FINISH=5 / CUT_SHORT=6)

  startedAt DateTime
  // startedAtが受信時刻からの推定値か。接続はprocessInitialData:falseなので配信の
  // 途中から繋ぐと開始(OPEN)を取り逃す。BattleSetting.startTimeMsも取れなかった場合、
  // startedAtは「気づいた時刻」でしかない。イベント側の照合はこれを見て信頼度を決める。
  startedAtEstimated Boolean @default(true)

  endedAt     DateTime?
  durationSec Int? // BattleSetting.duration(秒)。終了を取り逃したときの終了時刻の推定に使う
  hostUserIds    String[]  @default([]) // anchorIdStr(数値文字列)
  hostDisplayIds String[]  @default([]) // anchorInfo[].user.displayId(ハンドル相当・未検証)
  hostScores     Json      @default("{}") // anchorIdStr -> hostScore(stringのまま)
  raw            Json // 受信したpayloadそのもの。実payloadのfixture取得と後追い調査用
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  room TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("tiktok_battles")
  @@unique([roomId, battleId])
  @@index([roomId, startedAt])
  @@index([battleId])
  @@schema("public")
}

// ============================================================================
// event — イベント(大会)運営
//
// public のデータ(gifts / TiktokRoom / Streamer)は同じ Prisma Client から
// 直接読める。以前は列を絞った view 経由で読んでいたが、統合により不要になった。
// 参照は src/event/analytics-db.ts に集約する。
// ============================================================================

model Event {
  id          String  @id @default(cuid())
  slug        String  @unique // 公開URL /e/{slug}
  title       String
  description String? @db.Text
  // Railway Bucket(S3互換)上のオブジェクトキー。生のURLは保存しない
  // — 読み出しのたびに src/lib/media-storage.ts が presigned GET を発行する(media-storage.ts参照)。
  coverImageKey String?
  prizeText     String? @db.Text // 優勝賞品。公開ページでは空なら賞品セクション自体を出さない
  noticeText    String? @db.Text // 注意事項+FAQ(軽量Markdownサブセット。src/event/notice-blocks.ts が解釈する)
  ownerUserId   String // User.id。FKは張らない(将来 auth サービスへ切り出すため)

  format     String // "TOURNAMENT" | "DIAMOND_RACE" | "DEATHMATCH"
  entryMode  String // "SOLO" | "TEAM"
  teamPreset String @default("GENERIC") // "GENERIC" | "PREFECTURE"
  // 公開範囲がすべてを制御する。PRIVATE はオーナー以外誰にも見せない(下書き概念を統合)。
  visibility String @default("PRIVATE") // "PUBLIC" | "PRIVATE"
  status     String @default("SCHEDULED") // "SCHEDULED"|"RUNNING"|"FINISHED"|"ARCHIVED"

  // 全開催日程を覆う外枠。**sessions からの派生値**で、
  // startAt = min(sessions.startAt) / endAt = max(sessions.endAt)。
  // 集計する区間そのものは sessions(EventSession)。日程の隙間は集計に入らない。
  // 外枠を持つのは、集計対象の抽出・最終集計の締切・room 監視期限・一覧の表示が
  // 子テーブルの min/max を毎回引かずに済むようにするため。
  // **書き込みは日程と必ず同じトランザクションで行う**(イベント作成・更新APIだけ)。
  startAt DateTime
  endAt   DateTime
  // 名前空間ごとのルール。"deathmatch"(初期ライフ等、parseDeathmatchRules)と
  // "matchRules"(グローブ/ブースター等、parseMatchRules)を持つ。
  // 名前空間の追加・更新は既存キーを潰さないよう必ず `{ ...existing, <namespace>: ... }` で書く。
  rules Json @default("{}")

  lastAggregatedAt DateTime?
  aggregateMs      Int? // 直近の再集計にかかった時間(SLO監視用)
  // 締切(endAt + 猶予)を過ぎてからの最終集計が1回成功した時刻。
  // これが入るまでは status を FINISHED にしても集計を続ける(遅れて保存された
  // ギフトを取り込むため)。逆にこれが入ったら以後は集計しない。
  // 主催者が endAt を延ばしたら null に戻して再開させる。
  finalizedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions      EventSession[]
  teams         EventTeam[]
  participants  EventParticipant[]
  multipliers   EventMultiplier[]
  matches       EventMatch[]
  contributions EventContribution[]
  standings     EventStanding[]
  lifePoints    EventLifePoint[]
  lifeLedger    EventLifeLedger[]
  roomLeases    EventRoomLease[]
  adjustments   EventScoreAdjustment[]

  @@index([status, endAt])
  @@index([ownerUserId])
  @@schema("event")
}

// 開催日程。1つのイベントを複数の時間帯に分けて開催できる
// (例: 1日目 22:00-23:00 予選 / 2日目 22:00-23:00 決勝)。
//
// - 集計区間は日程ごとの [startAt, endAt) の半開区間。**日程の隙間は集計に入らない**
// - 日程どうしは重ならない(重なると同じギフトを二重に数える)。検証は
//   src/event/sessions.ts の normalizeSessionInputs が持つ
// - 並び順は startAt 昇順。重なりがないので sortOrder 列は持たない
// - **0件のイベントがありうる**(この機能より前に作られたもの)。その場合は
//   Event の外枠 [startAt, endAt) を1日程とみなす(resolveEventWindows)
model EventSession {
  id        String   @id @default(cuid())
  eventId   String
  name      String? // "予選" などの任意ラベル
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startAt])
  @@schema("event")
}

// 倍率オプション。kind を増やすだけで新しい倍率条件を足せる。
// 1件のギフトに適用される倍率は必ず1つ(src/event/scoring.ts を参照)。
model EventMultiplier {
  id        String    @id @default(cuid())
  eventId   String
  kind      String // "BATTLE"(バトル中) | "SOLO_STREAM"(枠投げ)
  factor    Decimal   @db.Decimal(6, 2) // 2.00 など
  startAt   DateTime? // 期間限定倍率。null なら常時
  endAt     DateTime?
  createdAt DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@schema("event")
}

model EventTeam {
  id             String  @id @default(cuid())
  eventId        String
  name           String
  colorHex       String?
  prefectureCode String? // teamPreset = "PREFECTURE" のとき "01".."47"
  sortOrder      Int     @default(0)

  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participants EventParticipant[]
  sides        EventMatchSide[]

  @@unique([eventId, name])
  @@unique([eventId, prefectureCode])
  @@schema("event")
}

model EventParticipant {
  id          String   @id @default(cuid())
  eventId     String
  tiktokId    String // 正規化済み(小文字・trim・先頭@除去)
  roomId      String // TiktokRoom.id(論理参照)
  teamId      String?
  displayName String // 表示名スナップショット
  userId      String? // 会員登録済みならリンク
  status      String   @default("ACTIVE") // "INVITED"|"ACTIVE"|"WITHDRAWN"|"DISQUALIFIED"
  joinedAt    DateTime @default(now())

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team  EventTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sides EventMatchSideParticipant[]

  @@unique([eventId, tiktokId])
  // 同じ room を別表記で二重登録させない = 同じギフトの二重計上を防ぐ。
  // TiktokRoom は複数 Streamer に共有されるため、tiktokId の unique だけでは足りない。
  @@unique([eventId, roomId])
  @@schema("event")
}

// イベントのために確保した room 監視の台帳。
// TiktokRoom.monitorUntil を立てた事実をこちらで持つ。
model EventRoomLease {
  id              String    @id @default(cuid())
  eventId         String
  roomId          String
  tiktokId        String
  createdBySystem Boolean   @default(false) // イベントが room を新規作成したか
  monitorUntil    DateTime // 通常は event.endAt + 猶予
  releasedAt      DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, roomId])
  @@index([roomId, releasedAt])
  @@schema("event")
}

// 対戦(トーナメント1試合 / デスマッチの1マッチ)
model EventMatch {
  id              String @id @default(cuid())
  eventId         String
  round           Int    @default(1)
  bracketPosition Int    @default(0)
  matchType       String @default("1V1") // "1V1" | "2V2"

  scheduledStartAt DateTime // 主催者が指定した時間枠。判定は [start, end) の半開区間
  scheduledEndAt   DateTime
  // "SCHEDULED"    まだバトルを検知していない
  // "LIVE"         検知して進行中
  // "DETECTED"     検知して終了。集計で勝者を決める段階
  // "NEEDS_REVIEW" 検知したが自動確定できない(部分一致 / 2vs2)。主催者の承認待ち
  // "FINISHED"     勝者が確定した
  // "NO_SHOW"      時間枠を過ぎても検知できなかった
  // "VOID"         主催者が無効にした
  status String @default("SCHEDULED")

  detectedBattleId String? // TikTok の battleId。string のまま保持する
  detectedStartAt  DateTime?
  detectedEndAt    DateTime?
  // "exact"  = 観測した room の集合が対戦カードと完全一致した
  // "partial" = 一部の room しか観測できなかった(相手が参加者でない・監視が落ちていた等)
  detectionConfidence String?
  // 検知した終了時刻の出所。"observed"(終了イベント) / "duration"(設定値から計算) /
  // "scheduled"(予定終了時刻へのフォールバック)。後から検証できるように残す。
  detectedEndSource   String?

  winnerSideId String?
  // 勝敗の決め方。"AGGREGATE"(こちらの集計) / "MANUAL"(主催者が確定) / "BYE"(不戦勝) / "DRAW"(引き分け)
  winnerDecidedBy String?

  rules Json @default("{}") // 種目別ルールと、判定時の補足情報

  event Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sides EventMatchSide[]

  @@index([eventId, scheduledStartAt])
  @@index([detectedBattleId])
  @@schema("event")
}

model EventMatchSide {
  id        String  @id @default(cuid())
  matchId   String
  sideIndex Int // 0 | 1
  teamId    String?
  score     Decimal @default(0) @db.Decimal(18, 2) // 倍率適用後
  diamonds  BigInt  @default(0) // 素のダイヤ

  match        EventMatch                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team         EventTeam?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  participants EventMatchSideParticipant[]

  @@unique([matchId, sideIndex])
  @@schema("event")
}

model EventMatchSideParticipant {
  id            String @id @default(cuid())
  sideId        String
  participantId String

  side        EventMatchSide   @relation(fields: [sideId], references: [id], onDelete: Cascade)
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sideId, participantId])
  @@schema("event")
}

// デスマッチのライフポイント
model EventLifePoint {
  id           String    @id @default(cuid())
  eventId      String
  subjectType  String // "PARTICIPANT" | "TEAM"
  subjectId    String
  current      Int
  max          Int
  eliminatedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, subjectType, subjectId])
  @@schema("event")
}

// ライフ増減の履歴。後から検証できるように必ず残す。
model EventLifeLedger {
  id          String   @id @default(cuid())
  eventId     String
  subjectType String
  subjectId   String
  matchId     String?
  delta       Int
  reason      String // "MATCH_LOSS" | "MATCH_WIN" | "MATCH_DRAW"
  createdAt   DateTime @default(now())

  // イベント削除で一緒に消す。関連を張らないと履歴だけが孤児として残り続ける。
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, subjectType, subjectId])
  @@schema("event")
}

// 主催者によるスコア手動補正。
// gifts は取り込み時点の欠落・重複を後から修復できないため、救済手段を必ず持つ。
model EventScoreAdjustment {
  id               String   @id @default(cuid())
  eventId          String
  scope            String // "PARTICIPANT" | "TEAM" | "MATCH"
  scopeId          String
  listenerUniqueId String? // 特定リスナーへの補正なら
  diamondDelta     BigInt   @default(0)
  reason           String   @db.Text
  createdByUserId  String
  createdAt        DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, scope, scopeId])
  @@schema("event")
}

// リスナー貢献の集計スナップショット。3種のランキングをこの1テーブルで賄う。
model EventContribution {
  id               String   @id @default(cuid())
  eventId          String
  scope            String // "EVENT" | "PARTICIPANT" | "TEAM" | "MATCH"
  scopeId          String   @default("") // participantId / teamId / matchId(EVENT のときは "")
  listenerUniqueId String // gifts.uniqueId
  nickname         String
  profileImageUrl  String?
  diamonds         BigInt   @default(0) // 実弾(素のダイヤ)
  points           Decimal  @default(0) @db.Decimal(18, 2) // 倍率適用後
  giftCount        Int      @default(0)
  // そのリスナーが最も多くポイントを入れた参加者。scope="EVENT" のときだけ入る
  // (PARTICIPANT / TEAM は scope 自体が答えなので null)。
  // EventStanding.subjectId と同じく **FK を張らない** — 参加者が消えても集計を壊さず、
  // 次の再集計で消える/付け替わるのに任せる。読み側は解決できなければ表示しない。
  topParticipantId String?
  // そのリスナーがギフトを入れた参加者の人数。scope="EVENT" のときだけ意味を持つ
  participantCount Int      @default(0)
  updatedAt        DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, scope, scopeId, listenerUniqueId])
  @@index([eventId, scope, scopeId, points])
  @@index([eventId, scope, scopeId, diamonds])
  @@schema("event")
}

// 順位表スナップショット(レース・チーム戦・全体順位)
model EventStanding {
  id          String   @id @default(cuid())
  eventId     String
  subjectType String // "PARTICIPANT" | "TEAM"
  subjectId   String
  diamonds    BigInt   @default(0)
  points      Decimal  @default(0) @db.Decimal(18, 2)
  rank        Int      @default(0)
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, subjectType, subjectId])
  @@index([eventId, subjectType, rank])
  @@schema("event")
}

// TiktokBattle から取り込んだバトルの観測記録。EventMatch への照合前の生データ。
//
// **1つのバトルにつき、両サイドの room ぶんの行ができる**(両方をイベントが監視している場合)。
// `battleId` でグループ化した roomId の集合が「そのバトルの参加者」になる。
// 相手の TikTok ハンドルは payload に含まれない(anchorInfo に uniqueId が無い)ので、
// この roomId 集合による照合が唯一の確実な手段。`src/event/match-detect.ts` を参照。
model DetectedBattle {
  id       String @id @default(cuid())
  battleId String // TikTok の battleId。string のまま
  roomId   String

  startedAt DateTime
  // startedAt が受信時刻からの推定値か。配信の途中から接続すると開始(OPEN)を取り逃す。
  startedAtEstimated Boolean @default(true)

  endedAt     DateTime?
  durationSec Int? // BattleSetting.duration(秒)。終了を取り逃したときの推定に使う
  lastAction  Int // 最後に観測した BattleAction(4=OPEN, 5=FINISH, 6=CUT_SHORT)

  hostUserIds    String[] @default([]) // anchorIdStr(数値文字列)
  hostDisplayIds String[] @default([]) // anchorInfo[].user.displayId(ハンドル相当・未検証)
  hostScores     Json     @default("{}") // anchorIdStr -> hostScore。TikTok 側の集計値、参考のみ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // **どのマッチに割り当てたかはここに持たない。** 同じ配信者が複数のイベントに
  // 出られる以上、1つのバトルが複数イベントの対戦カードに該当しうる。
  // 割当は EventMatch.detectedBattleId 側(イベントごと)だけが持つ。

  @@unique([battleId, roomId])
  @@index([startedAt])
  @@index([roomId, startedAt])
  @@schema("event")
}
