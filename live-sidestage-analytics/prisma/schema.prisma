generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

// **このファイルが public / event 両スキーマの唯一の正。**
//
// 以前は event を別プロジェクト・別 Prisma にしていたが、そちらの schemas に public を
// 足すと、向こうに書いていない gifts / TiktokRoom / Streamer が
// `db push --accept-data-loss` の削除差分になるという事故が起きうる構造だった。
// 1つの schema.prisma が両方を書くことで、その危険が構造的に消える。
//
// スキーマを分けたままにしているのは、テーブルの役割が違うため(public = TikTok の受信データと
// 認証、event = イベント運営)。ロールによる権限分割は行っていない。
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "event"]
}

// ============================================================================
// public — TikTok Live の受信データと認証
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  streamer     Streamer?
  subscription Subscription?

  @@schema("public")
}

enum PlanTier {
  FREE
  PRO
  ULTRA

  @@schema("public")
}

// User単位の課金プラン。行が無いUser = FREE扱い(全Userに先回りして作らない)。
// event機能はUser.idへの生FKを張らない方針(Event.ownerUserId参照)なので、
// event側からもこのモデルをuserIdの一致だけで参照する。
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 PlanTier  @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  status               String? // Stripeのsubscription.statusをそのまま保存(active/past_due/canceled等)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // onDelete: Cascadeで行ごと消える = Stripe側の課金は残ったままDB上の紐付けだけ失う。
  // User削除機能は現状無いが、将来足す場合はStripe側のsubscription解約も併せて行うこと。
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // プロバイダが申告したメール。**表示・運用のためだけに持つ**。
  //
  // アカウントのリンク判定に使ってはいけない(それは User.email の役割)。
  // Apple 経由の User は「Google と統合されない」ために User.email を持たないので、
  // 画面に出すメールはここから取る。詳細は src/lib/apple-account.ts
  //
  // 列名を email にしないのは、PrismaAdapter が渡された data を絞らず
  // account.create({ data }) へ素通しするため。将来プロバイダが email を含む
  // account オブジェクトを返したときに、意図せずここへ書かれるのを避ける。
  // unique も付けない(付けると同じメールで別プロバイダにログインできなくなる)。
  providerEmail String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("public")
}

// 1つのTikTokアカウント(tiktokId)につき1本のTikTok Live接続を共有するための実体。
// 複数のStreamer行(=複数ユーザー)が同じtiktokIdを登録した場合、全員がこのTiktokRoomを
// 経由して同じ接続・同じGiftデータを参照する(接続リソースの重複と、orderIdユニーク制約
// 違反によるギフト取りこぼしを防ぐため)。
model TiktokRoom {
  id                String    @id @default(cuid())
  tiktokId          String    @unique // 正規化済み(小文字化・trim・先頭@除去)
  deviceId          String?
  workerId          Int? // 担当Workerプロセス番号(hash(roomId) % WORKER_COUNTで初回決定し固定)
  proxyKey          String? // TIKTOK_PROXY_POOL内のインデックス(sticky割当、egress IP分散用)
  listenerStatus    String?
  listenerMessage   String?
  listenerUpdatedAt DateTime?

  // --- 表示用に正規化した接続状態 ---
  //
  // listenerStatus は「配信しているか」と「接続が健全か」を1つの文字列に混ぜている。
  // 特に retrying は オフライン / 接続失敗 / 署名APIのレート制限 のすべてに使われ、
  // updateState(..., "error") は一度も呼ばれない。この2軸に分けないと
  // 「配信開始待ち」と「TikTok側の障害」を区別して出せない。
  //
  // **listenerStatus の意味は変えない。** tiktok-room-cleanup.ts の候補抽出
  // (listenerStatus IN ('retrying','error')) をはじめ既存の消費者がそのまま動く。
  // これらは追加の列で、書き込みは persistState() に一本化する。
  listenerActivity String? // "live" | "offline" | "unknown"
  listenerHealth   String? // "ok" | "connecting" | "error"
  listenerReason   String? // scheduleReconnect() の reason。問い合わせ時の切り分け用

  // 書き込み順序の正本。**単調増加で、これより小さい値の書き込みは棄却する**(fencing)。
  //
  // persistState() は await されず順序保証もないので、同一プロセス内でも
  // 「古い connected heartbeat が retrying の後に着弾する」ことがある。さらにデプロイ中は
  // 新旧Workerが同じ部屋へ並走し、旧Workerのshutdownが書く idle が新Workerの connected に
  // 勝ちうる。壁時計は複数コンテナ間で単調ではないので、DB採番の世代(ListenerEpoch)を使う。
  //
  // 値は epoch * LISTENER_REVISION_STRIDE + プロセス内連番。
  listenerRevision BigInt?
  // イベント(event スキーマ側)が期限付きで監視を要求している場合の期限。
  // これが未来の間は、Streamerが1人もいなくてもWorkerが接続を維持する(getMyRooms参照)。
  // 期限切れ後は次のreconcileで切断されるが、受信済みのGiftはそのまま残る。
  monitorUntil     DateTime?
  createdAt        DateTime  @default(now())

  // --- TikTok非実在Streamer自動削除(tiktok-room-cleanup.ts)用 ---
  // listenerStatusがretrying/errorに入った最初の時刻。connectedに戻ったらnullに戻す。
  // "connecting"遷移では絶対に触らない(再接続試行のたびに数十秒間隔で走るため、
  // ここでリセットすると不健全継続時間が永久にゼロへ巻き戻ってしまう)。
  // 書き込みはpersistState()(tiktok-listener.ts)に一本化する。
  unhealthySince       DateTime?
  // fetchTiktokProfile()がNOT_FOUNDを連続で返した回数。ok:trueで確定的に0へリセットする。
  // RATE_LIMITED/ERRORでは増減しない(判定不能として無視。TikTok側の一時的なレート制限が
  // 続く間は永久に連続回数を達成できなくなる自己矛盾を避けるため)。
  notFoundStreak       Int       @default(0)
  // 上記ストリークの初回NOT_FOUND検出時刻。ストリークが0に戻ったらnullに戻す。
  notFoundFirstAt      DateTime?
  // このRoomに対しfetchTiktokProfile()を最後に実行した時刻(結果を問わず)。
  // 同じ部屋への過度な再チェックを防ぐクールダウンと、候補選定の公平なローテーションに使う。
  lastExistenceCheckAt DateTime?

  // TikTokの数値userId(api-live/user/room/ の data.user.id)。バトルpayloadのanchorIdStrと
  // 同じ空間で、tiktok_battles.hostScoresのキーと突き合わせてバトルスコアを配信者へ帰属させる。
  // avatar URLと違って**不変**なので保存してよい(署名付きURLのように失効しない)。
  // 書き込みはsrc/lib/tiktok-host-id.tsの1箇所だけ。一度入った値は上書きしない
  // (updateManyのwhereでhostUserId: nullを条件にして構造的に保証する)。
  hostUserId String?

  streamers   Streamer[]
  gifts       Gift[]
  battles     TiktokBattle[]
  watches     AgencyWatch[]
  likeTallies LikeTally[]

  // getMyRooms()の「担当workerId かつ (購読者あり または monitorUntilが未来)」検索用。
  // 期限切れの監視要求が蓄積しても60秒ごとのreconcileが重くならないようにする。
  @@index([workerId, monitorUntil])
  // tiktok-room-cleanup.tsの候補抽出クエリ用(listenerStatus + unhealthySince の複合条件)。
  @@index([listenerStatus, unhealthySince])
  @@schema("public")
}

// listener状態の書き込みをフェンスするための世代番号。
//
// プロセス起動時に1行 insert し、採番された id をそのプロセスの世代として使う。
// **後から起動したプロセスほど必ず大きい値になる**ことだけが要件で、壁時計に依存しない
// (複数コンテナ間でNTPずれがあっても順序が壊れない)。
//
// 1デプロイあたりWorker数ぶんしか増えないので、行数は年に数百のオーダー。
model ListenerEpoch {
  id          Int      @id @default(autoincrement())
  // どのプロセスが取った世代か。障害時の追跡用で、判定には使わない。
  role        String? // "worker" | "web"
  workerIndex Int?
  startedAt   DateTime @default(now())

  @@schema("public")
}

// 事務所・企業向けのアカウント。配信者本人(Streamer)とは独立していて、
// 自分ではTikTok IDを持たず、監視対象(AgencyWatch)を通してのみデータを参照する。
//
// Userではなくemailを識別子にしている。管理者が相手のGoogleアカウントのメールアドレスを
// 先に登録し、本人がそのアカウントでログインした時点で使えるようにするため
// (ログイン前はUser行が存在しないので、userIdでは紐づけられない)。
// 事務所が存在すること自体が利用許可であり、別途の承認フラグは持たない。
model Agency {
  id              String   @id @default(cuid())
  email           String   @unique // 管理者が登録したGoogleアカウント。小文字に正規化して保存する
  name            String
  // 企業向けAPIキーはSHA-256ハッシュで保存する(Streamer.apiKeyの平文保存は踏襲しない)。
  // 参照は常にキー本体のハッシュで引くため、平文を持たなくても認証できる。
  apiKeyHash      String?  @unique
  maxWatchTargets Int      @default(10) // 監視対象の上限。1件ごとにTikTok接続とproxy枠を消費するため必須
  createdAt       DateTime @default(now())

  watches AgencyWatch[]

  @@schema("public")
}

// 事務所が監視対象に指定したライバー。ギフトデータはTiktokRoom単位で共有されるため
// roomIdで紐づける(Streamerと同じ設計)。tiktokIdは事務所の入力値そのままを表示用に保持し、
// 正規化済みの値はTiktokRoom側だけが単一の正として持つ。
// 配信者本人の登録(Streamer)は必要なく、Streamerが0人でもwatchがあればWorkerが接続する。
model AgencyWatch {
  id        String   @id @default(cuid())
  agencyId  String
  roomId    String
  tiktokId  String // 表示用。ユーザー入力値そのまま
  label     String? // 事務所側の管理名(本名・所属チームなど)
  createdAt DateTime @default(now())

  agency Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  room   TiktokRoom @relation(fields: [roomId], references: [id])

  @@unique([agencyId, roomId])
  @@index([roomId])
  @@schema("public")
}

model Streamer {
  id               String    @id @default(cuid())
  userId           String    @unique
  tiktokId         String // 表示用。ユーザー入力値そのまま(正規化はTiktokRoom側でのみ行う)
  verificationCode String
  verified         Boolean   @default(false)
  verifiedAt       DateTime?
  apiKey           String?   @unique
  createdAt        DateTime  @default(now())
  roomId           String? // 実際の接続・ギフトデータを共有するTiktokRoomへの紐付け

  overlayToken             String? @unique
  overlayDisplayReference  String  @default("today") // "today" | "fixed"
  overlayDisplayDate       String? // YYYY-MM-DD, overlayDisplayReference="fixed" のときのみ意味を持つ
  overlayThreshold         Int     @default(1000)
  overlayGoalCount         Int     @default(5)
  overlayVisibleRows       Int     @default(5) // この人数を超えたらスナップスクロール
  overlayNameMaxWidth      Int     @default(140) // px、これを超える名前は省略表示
  overlayAlign             String  @default("left") // "left" | "right"
  overlayHeadingBackground String  @default("clear") // "clear" | "crystal-blue" | "sakura-pink"
  overlayDisplaySpeed      Int     @default(3) // 1(遅い)〜5(速い)、スナップスクロールと全体縮小表示の待機時間を制御

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      TiktokRoom? @relation(fields: [roomId], references: [id])
  giftEdits GiftEdit[]

  // desktopの5ウィジェット移植で追加。既存のoverlay*列(contribution専用)とは分離し、
  // 種類ごとに1テーブルへ寄せてある(Streamerへ列を積み増し続けると肥大化するため)。
  overlayCoinListSettings         OverlayCoinListSettings?
  overlayTopGiftSettings          OverlayTopGiftSettings?
  overlayTapListSettings          OverlayTapListSettings?
  overlayLikeContributionSettings OverlayLikeContributionSettings?
  overlayTimerSettings            OverlayTimerSettings?
  overlayTimerState               OverlayTimerState?

  @@index([roomId])
  @@schema("public")
}

// TikTokの「いいね」日次累計。単発イベントのログは保持しない方針
// (like-contribution/tap-listウィジェットの要件: 累積カウンタのみで十分)。
// GiftとおなじくroomId単位で共有される(同じtiktokIdを複数Streamerが登録していれば
// 同じ行を参照する)。likeイベント自体には金銭的価値がなく再送/重複の実害が
// Giftより小さいため、Giftのような(roomId, orderId)unique制約やmsgId時間窓dedupまでは持たない
// — 増分はWorker側の秒単位コアレッシング+プロセス内msgId FIFOでのみ弾く。
model LikeTally {
  id              String   @id @default(cuid())
  roomId          String
  dayKey          String // jstDateKey()、Giftと同じ形式
  uniqueId        String
  nickname        String
  profileImageUrl String?
  totalLikes      Int      @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  room TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // (roomId, dayKey, uniqueId)のunique indexが(roomId, dayKey)検索もprefixでカバーするため、
  // 別途の@@indexは追加しない。
  @@unique([roomId, dayKey, uniqueId])
  @@map("like_tallies")
  @@schema("public")
}

model OverlayCoinListSettings {
  streamerId   String   @id
  fontKey      String   @default("default")
  textStyleKey String   @default("gold-night")
  strokeWidth  Int      @default(4)
  bgStyle      String   @default("transparent") // "transparent" | "semi"
  sortOrder    String   @default("desc") // "asc" | "desc"
  maxEntries   Int      @default(20) // 1-100
  rowGap       Int      @default(8)
  updatedAt    DateTime @updatedAt

  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("overlay_coin_list_settings")
  @@schema("public")
}

model OverlayTopGiftSettings {
  streamerId        String   @id
  fontKey           String   @default("default")
  textStyleKey      String   @default("gold-night")
  strokeWidth       Int      @default(4)
  title             String   @default("本日最高ギフト")
  senderDisplayMode String   @default("latest") // "latest" | "all"
  glowEnabled       Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("overlay_top_gift_settings")
  @@schema("public")
}

model OverlayTapListSettings {
  streamerId   String   @id
  fontKey      String   @default("default")
  textStyleKey String   @default("gold-night")
  strokeWidth  Int      @default(4)
  bgStyle      String   @default("transparent")
  maxEntries   Int      @default(20)
  rowGap       Int      @default(8)
  updatedAt    DateTime @updatedAt

  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("overlay_tap_list_settings")
  @@schema("public")
}

model OverlayLikeContributionSettings {
  streamerId       String   @id
  fontKey          String   @default("default")
  textStyleKey     String   @default("gold-night")
  strokeWidth      Int      @default(4)
  title            String   @default("Likeありがとう！")
  interval         Int      @default(50)
  soundVolume      Int      @default(100)
  balloonDesignKey String   @default("dark-glass")
  countFontSize    Int      @default(42)
  nameFontSize     Int      @default(34)
  updatedAt        DateTime @updatedAt

  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("overlay_like_contribution_settings")
  @@schema("public")
}

// タイマーオーバーレイの設定。1配信者(Streamer)につき1行。
// desktopのtimer-state.js DEFAULT_TIMER_SETTINGSを踏襲。音源は任意URLではなく
// プリセットキーで持つ(OBSブラウザソースに外部URLを無条件fetchさせないため。
// src/lib/overlay/sound-presets.ts 参照)。
model OverlayTimerSettings {
  streamerId String @id

  durationMinutes Int    @default(10) // start/reset時の初期値(分)
  durationSeconds Int    @default(0) // start/reset時の初期値(秒、0-59)
  headingText     String @default("カウントダウン")

  endSoundKey    String? // sound-presets.tsのキー。nullは無音
  endSoundVolume Int     @default(100) // 0-100

  minFloorMinutes   Int @default(0) // 短縮下限(分)。0=無制限に短縮可
  maxCeilingMinutes Int @default(0) // 延長上限(分)。0=無制限に延長可

  countdownSoundEnabled          Boolean @default(false)
  countdownSoundThresholdSeconds Int     @default(5)
  countdownSoundKey              String?
  countdownSoundVolume           Int     @default(100)

  fontKey      String @default("default")
  textStyleKey String @default("gold-night")
  strokeWidth  Int    @default(4)

  updatedAt DateTime @updatedAt

  streamer  Streamer               @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  giftRules OverlayTimerGiftRule[]

  @@map("overlay_timer_settings")
  @@schema("public")
}

// ギフト連動: 「このギフト名を受け取ったら±分数」のマッピング。複数登録可能。
// 一致キーはgiftIdではなく名前(trim+小文字化) — 既存のギフト照合規約に合わせる。
model OverlayTimerGiftRule {
  id           String   @id @default(cuid())
  streamerId   String
  giftName     String // trim+小文字化済みで保存
  minutesDelta Float // 1コンボ単位あたりの加減算量(分)。マイナスで短縮
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())

  settings OverlayTimerSettings @relation(fields: [streamerId], references: [streamerId], onDelete: Cascade)

  // streamerId単位のルール件数は少数(多くて数十件)想定のため、
  // (streamerId, enabled)の追加indexは持たない — @@uniqueのprefixで十分。
  @@unique([streamerId, giftName])
  @@map("overlay_timer_gift_rules")
  @@schema("public")
}

// タイマーの実行時状態。running/endsAt/remainingMsのみを永続化する。
// 発火(終了音等)はサーバーのsetTimeoutではなくクライアント側のローカル計算で行うため、
// ここにはタイムアウトハンドル相当の状態は一切持たない。
model OverlayTimerState {
  streamerId  String    @id
  running     Boolean   @default(false)
  endsAt      DateTime? // running=trueのときのみ意味を持つ(絶対時刻)
  remainingMs Int       @default(0)
  updatedAt   DateTime  @updatedAt

  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("overlay_timer_state")
  @@schema("public")
}

model AppSetting {
  key       String   @id
  value     String?  @db.Text
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model Gift {
  id              String   @id @default(cuid())
  roomId          String // TikTokアカウント単位で共有(同じtiktokIdを登録した全ユーザーが同じ行を参照)
  uniqueId        String
  nickname        String
  profileImageUrl String?
  giftId          Int
  giftName        String
  giftPictureUrl  String?
  repeatCount     Int      @default(1)
  diamondCount    Int      @default(0)
  totalDiamonds   Int      @default(0)
  receivedAt      DateTime @default(now())
  timeSource      String   @default("tiktok") // "tiktok" | "fallback" — fallback は TikTok createTime 欠落/不正でサーバー受信時刻を使用したことを示す
  dayKey          String
  orderId         String?
  groupId         String?
  // TikTok common.msgId。protobufの既定値"0"等、実IDとして使えない値は resolveMsgId() が null にする。
  // dedupキー。saveGift() が「直近5分に同じ (roomId, msgId) があるか」を引くのに使う
  // (@@index([roomId, msgId]))。**unique制約は張らない** — roomIdは配信セッション
  // ではなく永続的なTiktokRoom.idなので、将来の別ライブでmsgIdが再利用されたら正当なギフトを
  // 恒久的に弾いてしまう。加えて prisma db push は Dockerfile の CMD でコンテナ起動時に走るため、
  // 既存の重複行があるとunique index作成に失敗してWebが起動しなくなる。
  msgId           String?
  // 1 = combo可能ギフト。groupId="0" が3591件流入していて、それが実際にcomboなのか
  // 単発ギフトなのかを本番DBだけでは判定できないため、combo キーの設計見直し用に残す。
  giftType        Int?

  room  TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  edits GiftEdit[]

  @@unique([roomId, orderId])
  @@index([roomId, dayKey])
  @@index([roomId, receivedAt])
  @@index([roomId, uniqueId])
  @@index([roomId, groupId])
  @@index([roomId, msgId])
  @@map("gifts")
  @@schema("public")
}

// TikTokから受信したオリジナルのGiftは変更・削除しない。編集内容はここに別レコードとして保持し、
// 表示時のみ上書きする(オリジナルデータのみでの集計を別途可能にするため)。
// Giftはtiktokアカウント単位で共有されるため、編集/非表示はstreamerId単位に紐づけ、
// 編集した本人にしか見えないようにする(他の登録者のデータには影響しない)。
model GiftEdit {
  id            String   @id @default(cuid())
  giftId        String
  streamerId    String
  giftName      String
  totalDiamonds Int
  hidden        Boolean  @default(false) // trueの場合、この行を編集したstreamerの集計・履歴からのみ除外する
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gift     Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@unique([giftId, streamerId])
  @@map("gift_edits")
  @@schema("public")
}

// TikTokの全ギフトカタログ(webcastの `gift/list/` の結果)。全部屋で共有する1枚のテーブル。
// ギフトはほぼグローバルなので部屋ごとには持たない(部屋限定ギフトは和集合として混ざる)。
//
// **効果音の一致キーはgiftIdではなく名前。** gift/list/ は同じ名前に複数のgiftIdを割り当てており
// (実測670件中29名が重複)、giftId自体もレスポンス内で重複する(実測4行)。giftId照合にすると
// 同名の別IDを取りこぼすうえ、ピッカーに区別のつかない同名行が並ぶ。
// giftIdを主キーにしているのはカタログを素直な鏡として持つためだけで、
// 消費側(GET /api/mobile/gifts)は name で畳んでコイン数の範囲に集約して返す。
//
// upsertのみで削除はしない。したがって実体は「現在のカタログ」ではなく
// **「これまでに観測したカタログの和集合」**になる。候補一覧を出すのが目的なので意図的にそうしている
// (TikTok側のA/Bやproxyの地域差で一時的に欠けたギフトを消したくない)。
model TiktokGiftCatalog {
  giftId       Int      @id // gift/list/ の gift.id
  name         String // 一致キー。trim + 小文字化済み(chat:giftのgiftNameと同じ正規化)
  label        String // 表示用。カタログの元表記(英語)
  // TikTok公式の日本語表示名。`webcast_language=ja-JP` で叩いた gift/list/ から採る。
  // **表示専用。一致キーには使わない**(LIVEのgiftイベントは英語で来るため)。
  // 日本語版の取得に失敗した場合や、日本語環境でも英語表記のギフト以外で埋まらない場合は null。
  // 一時的な取得失敗で消えないよう、upsert時は COALESCE で既存値を守る。
  labelJa      String?
  diamondCount Int      @default(0)
  // ギフトのアイコン。gift/list/ の `image.url_list` から isAllowedAvatarUrl() を通ったURLだけを入れる。
  // avatar と違って**署名(x-expires)が付かないので永続化しても腐らない**。取れなければ null。
  imageUrl     String?
  fetchedAt    DateTime @default(now()) // 最後にカタログから見た時刻。TTL判定に使う。**upsert時に明示更新する**

  @@index([name])
  @@map("tiktok_gift_catalog")
  @@schema("public")
}

// TikTokのバトル(LinkMic Battle)の観測記録。イベントの対戦自動検知が使う。
// analytics自身はこのデータを使わないが、バトル中かどうかはWebcastのイベントでしか
// 分からないので受信側で残しておく。
//
// **1つのバトルについて、参加した両サイドのroomからそれぞれ同じbattleIdのイベントが届く。**
// (両方をこちらが監視している場合)。したがってbattleIdでグループ化すれば
// 「そのバトルに誰が参加したか」がpayloadの解釈精度に依存せず分かる。
// 相手のTikTokハンドル(uniqueId)はpayloadに含まれないため、この照合が唯一の確実な手段。
model TiktokBattle {
  id       String @id @default(cuid())
  roomId   String
  battleId String // TikTokのbattleId。API上stringなので数値化しない
  action   Int // 最後に観測したBattleAction(OPEN=4 / FINISH=5 / CUT_SHORT=6)

  startedAt          DateTime
  // startedAtが受信時刻からの推定値か。接続はprocessInitialData:falseなので配信の
  // 途中から繋ぐと開始(OPEN)を取り逃す。BattleSetting.startTimeMsも取れなかった場合、
  // startedAtは「気づいた時刻」でしかない。イベント側の照合はこれを見て信頼度を決める。
  startedAtEstimated Boolean  @default(true)

  endedAt        DateTime?
  durationSec    Int? // BattleSetting.duration(秒)。終了を取り逃したときの終了時刻の推定に使う
  hostUserIds    String[]  @default([]) // anchorIdStr(数値文字列)
  hostDisplayIds String[]  @default([]) // anchorInfo[].user.displayId(ハンドル相当・未検証)
  hostScores     Json      @default("{}") // anchorIdStr -> hostScore(stringのまま)
  raw            Json // 受信したpayloadそのもの。実payloadのfixture取得と後追い調査用
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  room TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, battleId])
  @@index([roomId, startedAt])
  @@index([battleId])
  @@map("tiktok_battles")
  @@schema("public")
}

// ============================================================================
// event — イベント(大会)運営
//
// public のデータ(gifts / TiktokRoom / Streamer)は同じ Prisma Client から
// 直接読める。以前は列を絞った view 経由で読んでいたが、統合により不要になった。
// 参照は src/event/analytics-db.ts に集約する。
// ============================================================================

model Event {
  id            String  @id @default(cuid())
  slug          String  @unique // 公開URL /e/{slug}
  title         String
  description   String? @db.Text
  // Railway Bucket(S3互換)上のオブジェクトキー。生のURLは保存しない
  // — 読み出しのたびに src/lib/media-storage.ts が presigned GET を発行する(media-storage.ts参照)。
  coverImageKey String?
  prizeText     String? @db.Text // 優勝賞品。公開ページでは空なら賞品セクション自体を出さない
  noticeText    String? @db.Text // 注意事項+FAQ(軽量Markdownサブセット。src/event/notice-blocks.ts が解釈する)
  ownerUserId   String // User.id。FKは張らない(将来 auth サービスへ切り出すため)

  format     String // "TOURNAMENT" | "DIAMOND_RACE" | "DEATHMATCH"
  entryMode  String // "SOLO" | "TEAM"
  teamPreset String @default("GENERIC") // "GENERIC" | "PREFECTURE"
  // 公開範囲がすべてを制御する。PRIVATE はオーナー以外誰にも見せない(下書き概念を統合)。
  visibility String @default("PRIVATE") // "PUBLIC" | "PRIVATE"
  status     String @default("SCHEDULED") // "SCHEDULED"|"RUNNING"|"FINISHED"|"ARCHIVED"

  // 全開催日程を覆う外枠。**sessions からの派生値**で、
  // startAt = min(sessions.startAt) / endAt = max(sessions.endAt)。
  // 集計する区間そのものは sessions(EventSession)。日程の隙間は集計に入らない。
  // 外枠を持つのは、集計対象の抽出・最終集計の締切・room 監視期限・一覧の表示が
  // 子テーブルの min/max を毎回引かずに済むようにするため。
  // **書き込みは日程と必ず同じトランザクションで行う**(イベント作成・更新APIだけ)。
  startAt DateTime
  endAt   DateTime
  // 名前空間ごとのルール。"deathmatch"(初期ライフ等、parseDeathmatchRules)と
  // "matchRules"(グローブ/ブースター等、parseMatchRules)を持つ。
  // 名前空間の追加・更新は既存キーを潰さないよう必ず `{ ...existing, <namespace>: ... }` で書く。
  rules   Json     @default("{}")

  lastAggregatedAt  DateTime?
  aggregateMs       Int? // 直近の再集計にかかった時間(SLO監視用)
  // スナップショット(EventContribution / EventStanding)を作った集計方式。
  // "FULL_PERIOD" = 開催日程の全ギフト / "BATTLE_ONLY" = 検知したバトル区間のギフトだけ。
  // null は方式を記録し始める前に最終集計を終えたイベント(FULL_PERIOD 相当)。
  // **主催者が設定する項目ではない。** aggregateEvent() が毎回書く。
  // finalizedAt が立ったイベントは再集計されないので、公開ページは format ではなく
  // この列を見て見出し・注記を決める(過去のスナップショットへ新しい説明を付けないため)。
  aggregationPolicy String?
  // 締切(endAt + 猶予)を過ぎてからの最終集計が1回成功した時刻。
  // これが入るまでは status を FINISHED にしても集計を続ける(遅れて保存された
  // ギフトを取り込むため)。逆にこれが入ったら以後は集計しない。
  // 主催者が endAt を延ばしたら null に戻して再開させる。
  finalizedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions      EventSession[]
  teams         EventTeam[]
  participants  EventParticipant[]
  multipliers   EventMultiplier[]
  matches       EventMatch[]
  contributions EventContribution[]
  standings     EventStanding[]
  lifePoints    EventLifePoint[]
  lifeLedger    EventLifeLedger[]
  roomLeases    EventRoomLease[]
  adjustments   EventScoreAdjustment[]

  @@index([status, endAt])
  @@index([ownerUserId])
  @@schema("event")
}

// 開催日程。1つのイベントを複数の時間帯に分けて開催できる
// (例: 1日目 22:00-23:00 予選 / 2日目 22:00-23:00 決勝)。
//
// - 集計区間は日程ごとの [startAt, endAt) の半開区間。**日程の隙間は集計に入らない**
// - 日程どうしは重ならない(重なると同じギフトを二重に数える)。検証は
//   src/event/sessions.ts の normalizeSessionInputs が持つ
// - 並び順は startAt 昇順。重なりがないので sortOrder 列は持たない
// - **0件のイベントがありうる**(この機能より前に作られたもの)。その場合は
//   Event の外枠 [startAt, endAt) を1日程とみなす(resolveEventWindows)
model EventSession {
  id        String   @id @default(cuid())
  eventId   String
  name      String? // "予選" などの任意ラベル
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())

  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  matches EventMatch[]

  // EventMatch からの複合FK `(eventId, sessionId)` の参照先。
  // これがないと「他イベントの日程を指す対戦」が DB 上成立してしまう。
  @@unique([eventId, id])
  @@index([eventId, startAt])
  @@schema("event")
}

// 倍率オプション。kind を増やすだけで新しい倍率条件を足せる。
// 1件のギフトに適用される倍率は必ず1つ(src/event/scoring.ts を参照)。
model EventMultiplier {
  id        String    @id @default(cuid())
  eventId   String
  kind      String // "BATTLE"(バトル中) | "SOLO_STREAM"(枠投げ)
  factor    Decimal   @db.Decimal(6, 2) // 2.00 など
  startAt   DateTime? // 期間限定倍率。null なら常時
  endAt     DateTime?
  createdAt DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@schema("event")
}

model EventTeam {
  id             String  @id @default(cuid())
  eventId        String
  name           String
  colorHex       String?
  prefectureCode String? // teamPreset = "PREFECTURE" のとき "01".."47"
  sortOrder      Int     @default(0)

  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participants EventParticipant[]
  sides        EventMatchSide[]

  @@unique([eventId, name])
  @@unique([eventId, prefectureCode])
  @@schema("event")
}

model EventParticipant {
  id          String   @id @default(cuid())
  eventId     String
  tiktokId    String // 正規化済み(小文字・trim・先頭@除去)
  roomId      String // TiktokRoom.id(論理参照)
  teamId      String?
  displayName String // イベント内の表示名。登録時の初期値は TikTok ID で、主催者があとから編集できる
  userId      String? // 会員登録済みならリンク
  status      String   @default("ACTIVE") // "INVITED"|"ACTIVE"|"WITHDRAWN"|"DISQUALIFIED"
  joinedAt    DateTime @default(now())

  // 対戦カードに表示するアバターの切り出し位置・ズーム。null = 現状のデフォルト表示
  // (object-position: 50% 30%, zoom: 1)。解決は src/event/avatar-frame.ts に閉じる。
  avatarOffsetX Float? // object-position の横位置(%, 0-100)
  avatarOffsetY Float? // object-position の縦位置(%, 0-100)
  avatarZoom    Float? // 拡大率(1-3)

  event Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team  EventTeam?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sides EventMatchSideParticipant[]

  @@unique([eventId, tiktokId])
  // 同じ room を別表記で二重登録させない = 同じギフトの二重計上を防ぐ。
  // TiktokRoom は複数 Streamer に共有されるため、tiktokId の unique だけでは足りない。
  @@unique([eventId, roomId])
  @@schema("event")
}

// イベントのために確保した room 監視の台帳。
// TiktokRoom.monitorUntil を立てた事実をこちらで持つ。
model EventRoomLease {
  id              String    @id @default(cuid())
  eventId         String
  roomId          String
  tiktokId        String
  createdBySystem Boolean   @default(false) // イベントが room を新規作成したか
  monitorUntil    DateTime // 通常は event.endAt + 猶予
  releasedAt      DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, roomId])
  @@index([roomId, releasedAt])
  @@schema("event")
}

// 対戦(トーナメント1試合 / デスマッチの1マッチ)
model EventMatch {
  id              String @id @default(cuid())
  eventId         String
  round           Int    @default(1)
  bracketPosition Int    @default(0)
  matchType       String @default("1V1") // "1V1" | "2V2"

  // この対戦をどの開催日程で行うか。**対戦に個別の時間枠は無い**
  // (日程まるごとが監視・検知の対象。詳細は src/event/CLAUDE.md)。
  // 既存行の穴埋めは scripts/migrate-match-session.ts が db push の前に済ませる
  // (db push は「既存データのある非NULL列の追加」を実行できないため)。
  sessionId        String
  // **旧: 主催者が指定した個別の時間枠。読まない。** 書き込みだけは当面続ける
  // (割り当てた日程の [startAt, endAt) をそのまま入れる) — ローリング更新や
  // ロールバックで旧コードが同時に動いても、必須列が null で落ちないようにするため。
  // 旧世代が完全に消えた後の別リリースで、書き込みごと消す。
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  // "SCHEDULED"    まだバトルを検知していない
  // "LIVE"         検知して進行中(終了時刻がまだ確定していない暫定関連を含む)
  // "DETECTED"     検知して終了。集計で勝者を決める段階
  // "NEEDS_REVIEW" 検知したが自動確定できない(部分一致 / 2vs2 / 候補が複数 / 終了未確定のまま日程終了)。主催者の承認待ち
  // "FINISHED"     勝者が確定した
  // "NO_SHOW"      日程が終わっても検知できなかった
  // "VOID"         主催者が無効にした
  status           String    @default("SCHEDULED")

  detectedBattleId    String? // TikTok の battleId。string のまま保持する
  detectedStartAt     DateTime?
  detectedEndAt       DateTime?
  // "exact"  = 観測した room の集合が対戦カードと完全一致した
  // "partial" = 一部の room しか観測できなかった(相手が参加者でない・監視が落ちていた等)
  detectionConfidence String?
  // 検知した終了時刻の出所。"observed"(終了イベント) / "duration"(設定値から計算)。
  // **予定終了時刻へのフォールバック("scheduled")は廃止した** —
  // 実測できない終了時刻を作ると、その区間ぶんの通常ギフトまでバトル倍率と勝敗に混ざる。
  detectedEndSource   String?

  winnerSideId    String?
  // 勝敗の決め方。"AGGREGATE"(こちらの集計) / "MANUAL"(主催者が確定) / "BYE"(不戦勝) / "DRAW"(引き分け)
  winnerDecidedBy String?
  // 決着時刻。デスマッチのライフはこの順に適用する(life-points.ts)。
  // **resolveMatchSeries() が AGGREGATE 決着時も必ず書く**(旧: detectedEndAt にフォール
  // バックしていたが、勝利条件(複数バトル)対応で decidedAt を優先参照先に統一した)。
  // 主催者が確定した場合はその時刻。**null は「まだ決着していない」。**
  // updatedAt を使わない(再集計のたびに動いて適用順が不安定になる)。
  decidedAt       DateTime?

  rules Json @default("{}") // 種目別ルールと、判定時の補足情報

  event            Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // **複合FK。** sessionId 単独だと他イベントの日程を指す行が DB 上成立してしまう。
  //
  // **onDelete は Restrict。** 対戦がぶら下がった日程を消せなくすることで、
  // 「日程を全置換する古いコード(または古いイメージ)が動くと表が丸ごと消える」事故を
  // DB 側で止める。日程の削除は更新APIが 409 で先に弾き、イベントごと消すときは
  // DELETE が対戦を明示的に消してから Event を消す。
  session          EventSession                @relation(fields: [eventId, sessionId], references: [eventId, id], onDelete: Restrict)
  sides            EventMatchSide[]
  battleCandidates EventMatchBattleCandidate[]

  @@index([eventId, sessionId])
  @@index([detectedBattleId])
  @@schema("event")
}

// 対戦カード(EventMatch)に紐づく、検知した「候補バトル」1件の検知結果だけを持つ。
// 勝利条件(matchRules.winCondition)が SINGLE なら通常1件、BEST_OF_THREE ならシリーズの
// 各ゲームぶん複数件になりうる。**採点(ダイヤ集計・勝敗)はキャッシュしない** —
// 全期間再計算という既存の集計哲学(aggregate.ts)に合わせ、resolveMatchSeries() が
// 呼ばれるたびに scoreSides() で毎回計算する。詳細は src/event/CLAUDE.md。
//
// DetectedBattle への FK は張らない(roomId ごとに複数行あり、event を跨いで共有される
// 疎結合テーブルのため。battleId は文字列のまま緩く参照する)。
model EventMatchBattleCandidate {
  id       String @id @default(cuid())
  matchId  String
  battleId String

  startedAt     DateTime
  endedAt       DateTime? // null = まだ進行中(暫定候補)
  endedAtSource String? // "observed" | "duration"
  confidence    String // "exact" | "partial"

  // 同じ battleId が2つ以上の EventMatch の room 集合と完全一致した(cross-match衝突。
  // デスマッチで同じ組み合わせが複数カードにあるケースを含む)。
  // **一度 true になったら「検知をやり直す」まで sticky に true のまま**(片方のマッチが
  // confirm で open から外れても、もう片方の曖昧判定が false へ戻らないように)。
  ambiguous Boolean @default(false)

  // 主催者が「候補過多(CANDIDATES_EXCEEDED)」画面で判定対象として選んだプール。
  // selectCandidates API だけが書く。一度立てたら resolveMatchSeries() は書き換えない
  // (主催者の意図をそのまま保持する — selected と役割を分けている理由は match-results.ts 参照)。
  organizerSelected Boolean @default(false)

  // resolveMatchSeries() が毎回計算する、現在の「実効ゲーム集合(effectiveGames)」に
  // 含まれるか。loadBattleRangesByRoom() はこの列だけを見る。
  selected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match EventMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, battleId])
  @@index([matchId])
  @@schema("event")
}

model EventMatchSide {
  id        String  @id @default(cuid())
  matchId   String
  sideIndex Int // 0 | 1
  teamId    String?
  score     Decimal @default(0) @db.Decimal(18, 2) // 倍率適用後
  diamonds  BigInt  @default(0) // 素のダイヤ

  match        EventMatch                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team         EventTeam?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  participants EventMatchSideParticipant[]

  @@unique([matchId, sideIndex])
  @@schema("event")
}

model EventMatchSideParticipant {
  id            String @id @default(cuid())
  sideId        String
  participantId String

  side        EventMatchSide   @relation(fields: [sideId], references: [id], onDelete: Cascade)
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sideId, participantId])
  @@schema("event")
}

// デスマッチのライフポイント
model EventLifePoint {
  id           String    @id @default(cuid())
  eventId      String
  subjectType  String // "PARTICIPANT" | "TEAM"
  subjectId    String
  current      Int
  max          Int
  eliminatedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, subjectType, subjectId])
  @@schema("event")
}

// ライフ増減の履歴。後から検証できるように必ず残す。
model EventLifeLedger {
  id          String   @id @default(cuid())
  eventId     String
  subjectType String
  subjectId   String
  matchId     String?
  delta       Int
  reason      String // "MATCH_LOSS" | "MATCH_WIN" | "MATCH_DRAW"
  createdAt   DateTime @default(now())

  // イベント削除で一緒に消す。関連を張らないと履歴だけが孤児として残り続ける。
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, subjectType, subjectId])
  @@schema("event")
}

// 主催者によるスコア手動補正。
// gifts は取り込み時点の欠落・重複を後から修復できないため、救済手段を必ず持つ。
model EventScoreAdjustment {
  id               String   @id @default(cuid())
  eventId          String
  scope            String // "PARTICIPANT" | "TEAM" | "MATCH"
  scopeId          String
  listenerUniqueId String? // 特定リスナーへの補正なら
  diamondDelta     BigInt   @default(0)
  reason           String   @db.Text
  createdByUserId  String
  createdAt        DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, scope, scopeId])
  @@schema("event")
}

// リスナー貢献の集計スナップショット。3種のランキングをこの1テーブルで賄う。
model EventContribution {
  id               String   @id @default(cuid())
  eventId          String
  scope            String // "EVENT" | "PARTICIPANT" | "TEAM" | "MATCH"
  scopeId          String   @default("") // participantId / teamId / matchId(EVENT のときは "")
  listenerUniqueId String // gifts.uniqueId
  nickname         String
  profileImageUrl  String?
  diamonds         BigInt   @default(0) // 実弾(素のダイヤ)
  points           Decimal  @default(0) @db.Decimal(18, 2) // 倍率適用後
  giftCount        Int      @default(0)
  // そのリスナーが最も多くポイントを入れた参加者。scope="EVENT" のときだけ入る
  // (PARTICIPANT / TEAM は scope 自体が答えなので null)。
  // EventStanding.subjectId と同じく **FK を張らない** — 参加者が消えても集計を壊さず、
  // 次の再集計で消える/付け替わるのに任せる。読み側は解決できなければ表示しない。
  topParticipantId String?
  // そのリスナーがギフトを入れた参加者の人数。scope="EVENT" のときだけ意味を持つ
  participantCount Int      @default(0)
  // 参加者ごとの内訳。scope="EVENT" のときだけ入る(形式は src/event/contribution-breakdown.ts)。
  // **null は「集計が内訳に未対応だった頃の行」**で、読み側は従来表示へフォールバックする。
  // finalizedAt が立ったイベントは再集計されないので、過去イベントの行は永久に null のまま残る。
  breakdown        Json?
  updatedAt        DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, scope, scopeId, listenerUniqueId])
  @@index([eventId, scope, scopeId, points])
  @@index([eventId, scope, scopeId, diamonds])
  @@schema("event")
}

// 順位表スナップショット(レース・チーム戦・全体順位)
model EventStanding {
  id          String   @id @default(cuid())
  eventId     String
  subjectType String // "PARTICIPANT" | "TEAM"
  subjectId   String
  diamonds    BigInt   @default(0)
  points      Decimal  @default(0) @db.Decimal(18, 2)
  rank        Int      @default(0)
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, subjectType, subjectId])
  @@index([eventId, subjectType, rank])
  @@schema("event")
}

// TiktokBattle から取り込んだバトルの観測記録。EventMatch への照合前の生データ。
//
// **1つのバトルにつき、両サイドの room ぶんの行ができる**(両方をイベントが監視している場合)。
// `battleId` でグループ化した roomId の集合が「そのバトルの参加者」になる。
// 相手の TikTok ハンドルは payload に含まれない(anchorInfo に uniqueId が無い)ので、
// この roomId 集合による照合が唯一の確実な手段。`src/event/match-detect.ts` を参照。
model DetectedBattle {
  id       String @id @default(cuid())
  battleId String // TikTok の battleId。string のまま
  roomId   String

  startedAt          DateTime
  // startedAt が受信時刻からの推定値か。配信の途中から接続すると開始(OPEN)を取り逃す。
  startedAtEstimated Boolean  @default(true)

  endedAt     DateTime?
  durationSec Int? // BattleSetting.duration(秒)。終了を取り逃したときの推定に使う
  lastAction  Int // 最後に観測した BattleAction(4=OPEN, 5=FINISH, 6=CUT_SHORT)

  hostUserIds    String[] @default([]) // anchorIdStr(数値文字列)
  hostDisplayIds String[] @default([]) // anchorInfo[].user.displayId(ハンドル相当・未検証)
  hostScores     Json     @default("{}") // anchorIdStr -> hostScore。TikTok 側の集計値、参考のみ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // **どのマッチに割り当てたかはここに持たない。** 同じ配信者が複数のイベントに
  // 出られる以上、1つのバトルが複数イベントの対戦カードに該当しうる。
  // 割当は EventMatch.detectedBattleId 側(イベントごと)だけが持つ。

  @@unique([battleId, roomId])
  @@index([startedAt])
  @@index([roomId, startedAt])
  @@schema("event")
}
