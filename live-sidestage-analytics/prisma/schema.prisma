generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "prismaSchemaFolder"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

// Schema set: all prisma/*.prisma files. One Prisma Client, one datasource, one migration history, one PostgreSQL database.

// **prisma/ 配下の .prisma ファイル群が public / event 両スキーマの唯一の正（1つの schema set）。**
//
// 以前は event を別プロジェクト・別 Prisma にしていたが、そちらの schemas に public を
// 足すと、向こうに書いていない gifts / TiktokRoom / Streamer が
// `db push --accept-data-loss` の削除差分になるという事故が起きうる構造だった。
// 1つの schema set が両方を書くことで、その危険が構造的に消える。
//
// スキーマを分けたままにしているのは、テーブルの役割が違うため(public = TikTok の受信データと
// 認証、event = イベント運営)。ロールによる権限分割は行っていない。
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "event"]
}
