generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

// **このファイルが public / event 両スキーマの唯一の正。**
//
// 以前は event を別プロジェクト・別 Prisma にしていたが、そちらの schemas に public を
// 足すと、向こうに書いていない gifts / TiktokRoom / Streamer が
// `db push --accept-data-loss` の削除差分になるという事故が起きうる構造だった。
// 1つの schema.prisma が両方を書くことで、その危険が構造的に消える。
//
// スキーマを分けたままにしているのは、テーブルの役割が違うため(public = TikTok の受信データと
// 認証、event = イベント運営)。ロールによる権限分割は行っていない。
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "event"]
}

// ============================================================================
// public — TikTok Live の受信データと認証
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  // 最終アクティブ日時。列新設直後はnull(=未記録)で、監視枠の低価値クリーンアップは
  // nullを「保護対象」として扱う(古いユーザーの誤削除防止)。ログイン成功時に加え、
  // 有効セッション/トークンでの日常アクセス時にもスロットル付きで更新する
  // (markLastActive()参照)。「ログイン」ではなく「アクティブ」なのは、JWTセッション/
  // 90日有効なモバイルトークンだと再ログインなしで長期間使われ続けるため。
  lastActiveAt  DateTime?

  accounts               Account[]
  sessions               Session[]
  streamer               Streamer?
  subscriptions          Subscription[]
  stripeCustomerLink     StripeCustomerLink?
  pendingPurchaseIntents PendingPurchaseIntent[]
  ambassador             Ambassador?
  ambassadorInvitesUsed  AmbassadorInvite[]

  @@schema("public")
}

// アンバサダー資格そのもの。Ambassador行がある = PROプラン無料(getUserPlan()参照)。
// 管理者画面(/admin/ambassadors)から招待URL経由の先着1名指定、または既存ユーザーへの
// 直接指定のいずれかで作られる。
model Ambassador {
  id          String   @id @default(cuid())
  principalId String   @unique
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// アンバサダー招待URLの発行記録。token経由で新規登録した先着1名だけが
// usedAt/usedByPrincipalIdを埋めてAmbassadorへ確定する(claim-ambassador-invite.ts)。
// 期限切れ(expiresAt超過)の行は ambassador-invite-retention.ts が定期削除する
// (使用済み・未使用を問わない。Ambassador本体は別テーブルに残るため削除して問題ない)。
model AmbassadorInvite {
  id                String    @id @default(cuid())
  token             String    @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  usedAt            DateTime?
  usedByPrincipalId String?
  usedByUser        User?     @relation(fields: [usedByPrincipalId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@schema("public")
}

enum PlanTier {
  FREE
  PRO
  ULTRA

  @@schema("public")
}

enum SubscriptionProvider {
  STRIPE
  GOOGLE_PLAY
  APPLE

  @@schema("public")
}

// User単位の課金プラン。行が無いUser = FREE扱い(全Userに先回りして作らない)。
// **1ユーザーが複数の有効な行を同時に持ちうる**(Web/Stripeとモバイル/Google Play・Appleは
// 別契約として独立に成立する)。getUserPlan()は有効な全行から最上位プランを算出する。
// event機能はUser.idへの生FKを張らない方針(Event.ownerPrincipalId参照)なので、
// event側からもこのモデルをprincipalIdの一致だけで参照する。
//
// フェーズA(拡張のみ)時点のスキーマ。provider/providerSubscriptionId等はnullable。
// 旧列(stripeCustomerId/stripeSubscriptionId/status)はフェーズB(破壊的クリーンアップ、
// 別コミット)まで残す。詳細は scripts/migrate-subscription-provider.ts。
// **principalIdに一意制約は無い(元から無い、フェーズBで消える予定の列でもない)。**
// 1ユーザーが複数provider(Stripe/Google Play/Apple)で同時に有効な行を持つのが
// 正しい状態のため。実装後レビューでコメント記載(旧版)が「principalId一意制約はフェーズBまで
// 残す」と誤っており、その前提でsync-subscription.tsのP2002 fallbackが書かれていたが、
// スキーマ上そもそも存在しない制約だった。fallbackはprovider+providerSubscriptionId
// 複合uniqueの衝突だけを扱うよう修正済み。
model Subscription {
  id          String   @id @default(cuid())
  principalId String
  plan        PlanTier @default(FREE)

  // フェーズA以降の新列。バックフィル前はnull。
  provider               SubscriptionProvider?
  // providerごとの一意キー。STRIPE: Subscription ID。GOOGLE_PLAY: purchaseToken
  // (再購読で新token発行時は別行、旧行はentitlementActive=falseに)。
  // APPLE: originalTransactionId(更新をまたいで不変)。
  providerSubscriptionId String?

  stripePriceId             String? // STRIPEのみ
  googleProductId           String? // GOOGLE_PLAYのみ
  googleObfuscatedAccountId String? // GOOGLE_PLAYのみ、横流し防止用
  appleProductId            String? // APPLEのみ
  appleAppAccountToken      String? // APPLEのみ、横流し防止用

  rawStatus         String? // providerの生status文字列
  entitlementActive Boolean   @default(false) // getUserPlan()が見るのはこれだけ
  lastVerifiedAt    DateTime? // sync系関数がre-fetchを開始した時刻。古いfetch結果による上書きを防ぐガードに使う
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // --- 旧列(フェーズBで削除) ---
  // **@uniqueを持たせない。** 複数行モデルへの移行後、同一Stripe Customerが解約→再購読すると
  // 旧行(entitlementActive=falseになっても行自体は残る)が同じstripeCustomerIdを持ったままなので、
  // 新規Subscription行のcreateが一意制約違反でP2002になり、複合key(provider,providerSubscriptionId)
  // 基準のP2002フォールバックでは救済できず、webhookが永久に失敗してentitlementが付かない
  // (実装後レビュー指摘)。customer↔userの一意な紐付けは既にStripeCustomerLinkが担っており、
  // ここは表示・フェーズB前の互換用ミラーでしかないためunique制約は不要。
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String? // Stripeのsubscription.statusをそのまま保存(active/past_due/canceled等)

  // onDelete: Cascadeで行ごと消える。DELETE /api/mobile/account はこの削除より前に
  // stripe.customers.del()でStripe側のCustomer(=関連subscription全て)を先に消しており、
  // 課金が残ったままDB上の紐付けだけ失う、という状態にはならない。
  user User @relation(fields: [principalId], references: [id], onDelete: Cascade)

  // nullable列を含む複合unique。旧行はprovider=nullのまま共存でき、
  // 新規行だけが実質的な一意性チェックを受ける(Postgresの複合unique indexの仕様)。
  @@unique([provider, providerSubscriptionId])
  @@index([principalId, entitlementActive])
  @@schema("public")
}

// 購読成立前の「Stripe Customerは作ったが未購読」の置き場(旧Subscriptionの間借り先を分離)
model StripeCustomerLink {
  principalId      String   @id
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())

  user User @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@schema("public")
}

// 購入開始時に発行するobfuscatedAccountId/appAccountTokenとprincipalIdの対応表。
// Subscription行は購入成立後にしか存在しないため、webhook(RTDN/App Store Server Notifications)が
// verify-purchaseより先に届いた場合、この表が無いとpurchaseToken/transactionIdからprincipalIdを解決できない
// (Stripeはcheckout session作成時にsubscription.metadata.principalIdを仕込めるが、Google/Appleの購入は
// クライアント発のapplicationUserNameしか経路が無いため、サーバー側で先に対応表を持つ必要がある)。
model PendingPurchaseIntent {
  id          String               @id @default(cuid())
  principalId String
  provider    SubscriptionProvider // GOOGLE_PLAY | APPLE のみ想定(STRIPEはmetadata.principalIdで完結)
  token       String // GOOGLE_PLAY: googleObfuscatedAccountId、APPLE: appAccountToken。サーバーが発行する
  expiresAt   DateTime // 発行から1時間
  consumedAt  DateTime? // Subscription行作成時に埋める。以後は解決対象から除外する

  createdAt DateTime @default(now())

  user User @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@unique([provider, token])
  @@schema("public")
}

// **Account.userId と Session.userId は識別子命名規約(principalId)の唯一の例外。**
// @next-auth/prisma-adapter が Prisma のフィールド名を直書きするため改名できない
// (@map で DB 列名だけ変えても Prisma フィールド名は変わらない)。この2つ以外に userId は存在しない。
model Account {
  id                String  @id @default(cuid())
  userId            String // 例外(NextAuth PrismaAdapter 制約)。実体は User.id = principalId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // プロバイダが申告したメール。**表示・運用のためだけに持つ**。
  //
  // アカウントのリンク判定に使ってはいけない(それは User.email の役割)。
  // Apple 経由の User は「Google と統合されない」ために User.email を持たないので、
  // 画面に出すメールはここから取る。詳細は src/lib/apple-account.ts
  //
  // 列名を email にしないのは、PrismaAdapter が渡された data を絞らず
  // account.create({ data }) へ素通しするため。将来プロバイダが email を含む
  // account オブジェクトを返したときに、意図せずここへ書かれるのを避ける。
  // unique も付けない(付けると同じメールで別プロバイダにログインできなくなる)。
  providerEmail String?

  // Apple の refresh_token を revoke するには、発行時に使った client_id が要る
  // (iOSは Bundle ID、Androidは Services ID。Apple revoke APIの要件)。
  // 発行後に Apple 側の設定(Services ID等)が変わっても正しくrevokeできるよう、
  // 都度 resolveClient() が返した値をそのまま保存する。Apple以外のprovider(Google)
  // では常にnull。詳細は src/lib/apple-auth.ts の revokeAppleToken()
  appleClientId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String // 例外(NextAuth PrismaAdapter 制約)。実体は User.id = principalId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("public")
}

// TikTokアカウントの正本。主キーは不変の数値ID(TLC の anchorIdStr / data.userId)。
// tiktokHandle と nickname は「最後に観測した表示用スナップショット」で、識別キーではない。
//
// **tiktokHandle → tiktokUid の逆引き表として使ってはならない。**
// 改名で空いたハンドルは第三者が取得しうるため、ハンドルから引いた tiktokUid は信用できない。
// よって tiktokHandle に unique を張らない(同一ハンドルを別時点で別 tiktokUid が持つのは正常)。
//
// 書き込みは src/lib/tiktok-user.ts の recordTikTokUser() だけ。更新は「非nullの値だけ反映する」
// last-write-wins(後続イベントが表示名を欠いていても既知の値を潰さない)。
model TikTokUser {
  tiktokUid    String   @id
  tiktokHandle String?
  nickname     String?
  firstSeenAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tiktokHandle]) // 運用調査専用(完全一致で引く psql 用)。b-treeなのでILIKE '%…%'には効かない
  @@map("tiktok_users")
  @@schema("public")
}

// 1つのTikTokアカウント(hostTiktokUid)につき1本のTikTok Live接続を共有するための実体。
// 複数のStreamer行(=複数ユーザー)が同じTikTokアカウントを登録した場合、全員がこのTiktokRoomを
// 経由して同じ接続・同じGiftデータを参照する(接続リソースの重複と、orderIdユニーク制約
// 違反によるギフト取りこぼしを防ぐため)。
model TiktokRoom {
  id                String    @id @default(cuid())
  // 可変の@ハンドル。正規化済み(小文字化・trim・先頭@除去)。**同一性の判定キーではない**
  // (room の同一性は hostTiktokUid で定義する)。改名で空いたハンドルを第三者が取得しうるので、
  // 同じ tiktokHandle を持つ行が複数存在するのは正常。TikTok接続にはハンドルが要るので保持する。
  tiktokHandle      String
  deviceId          String?
  workerId          Int? // 担当Workerプロセス番号(hash(roomId) % WORKER_COUNTで初回決定するが既定値にすぎない。worker-guardianの死亡移送・コラボ自己申告(ensureRoomWatchedForCollab)がhashと無関係な値を書くため、この列の値が常に正)
  proxyKey          String? // TIKTOK_PROXY_POOL内のインデックス(sticky割当、egress IP分散用)
  // このroomの監視をensureRoomWatchedForCollab()が新規作成/再開したときの発見経路。
  // "collab"(コラボ承諾のlinkLayer検知) | "battle_start"(バトル開始action:4の補助検知)。
  // Streamer登録・AgencyWatch・イベント監視由来はnullのまま。最初に監視を始めた経路を残す
  // (以後同じroomが別経路で再検知されても上書きしない。tiktok-room.ts参照)。
  watchSource       String?
  watchSourceAt     DateTime?
  // 開発用フラグ。trueのroomは、コラボ相手・バトル相手発見(recordCollabGroupChange/
  // watchBattleOpponents)のキック条件をStreamer購読と無関係に満たす(tiktok-listener.ts参照)。
  // 管理画面(/admin/workers)の「特別監視」トグルからのみ変更する。監視対象自体の判定
  // (watchedRoomFilter)には影響しない — あくまでコラボ発見の「発見元になれるか」のフラグ。
  specialWatch      Boolean   @default(false)
  listenerStatus    String?
  listenerMessage   String?
  listenerUpdatedAt DateTime?

  // --- 表示用に正規化した接続状態 ---
  //
  // listenerStatus は「配信しているか」と「接続が健全か」を1つの文字列に混ぜている。
  // 特に retrying は オフライン / 接続失敗 / 署名APIのレート制限 のすべてに使われ、
  // updateState(..., "error") は一度も呼ばれない。この2軸に分けないと
  // 「配信開始待ち」と「TikTok側の障害」を区別して出せない。
  //
  // **listenerStatus の意味は変えない。** tiktok-room-cleanup.ts の候補抽出
  // (listenerStatus IN ('retrying','error')) をはじめ既存の消費者がそのまま動く。
  // これらは追加の列で、書き込みは persistState() に一本化する。
  listenerActivity String? // "live" | "offline" | "unknown"
  listenerHealth   String? // "ok" | "connecting" | "error"
  listenerReason   String? // scheduleReconnect() の reason。問い合わせ時の切り分け用

  // 書き込み順序の正本。**単調増加で、これより小さい値の書き込みは棄却する**(fencing)。
  //
  // persistState() は await されず順序保証もないので、同一プロセス内でも
  // 「古い connected heartbeat が retrying の後に着弾する」ことがある。さらにデプロイ中は
  // 新旧Workerが同じ部屋へ並走し、旧Workerのshutdownが書く idle が新Workerの connected に
  // 勝ちうる。壁時計は複数コンテナ間で単調ではないので、DB採番の世代(ListenerEpoch)を使う。
  //
  // 値は epoch * LISTENER_REVISION_STRIDE + プロセス内連番。
  listenerRevision BigInt?
  // イベント(event スキーマ側)が期限付きで監視を要求している場合の期限。
  // これが未来の間は、Streamerが1人もいなくてもWorkerが接続を維持する(getMyRooms参照)。
  // 期限切れ後は次のreconcileで切断されるが、受信済みのGiftはそのまま残る。
  monitorUntil     DateTime?
  createdAt        DateTime  @default(now())

  // Sidestageユーザー(Streamer登録/AgencyWatch/monitorUntil)に紐づかない匿名観測room
  // (コラボ検知等で発見されただけのroom)を対象にした、無視聴放置による自動監視停止
  // (anonymousRoomAutoStopEnabled、tiktok-listener.ts watchedRoomFilter参照)用。
  // 「監視指示」(resolveRoomForStreamer/ensureRoomWatchedForCollab/オーバーレイアクセス等)
  // のたびにreviveSuspendedMonitoring()が現在時刻へ更新する。新規create時は@default(now())
  // により初回監視指示として扱われる。
  lastWatchInstructedAt DateTime @default(now())

  // --- TikTok非実在Streamer自動削除(tiktok-room-cleanup.ts)用 ---
  // listenerStatusがretrying/errorに入った最初の時刻。connectedに戻ったらnullに戻す。
  // "connecting"遷移では絶対に触らない(再接続試行のたびに数十秒間隔で走るため、
  // ここでリセットすると不健全継続時間が永久にゼロへ巻き戻ってしまう)。
  // 書き込みはpersistState()(tiktok-listener.ts)に一本化する。
  unhealthySince       DateTime?
  // fetchTiktokProfile()がNOT_FOUNDを連続で返した回数。ok:trueで確定的に0へリセットする。
  // RATE_LIMITED/ERRORでは増減しない(判定不能として無視。TikTok側の一時的なレート制限が
  // 続く間は永久に連続回数を達成できなくなる自己矛盾を避けるため)。
  notFoundStreak       Int       @default(0)
  // 上記ストリークの初回NOT_FOUND検出時刻。ストリークが0に戻ったらnullに戻す。
  notFoundFirstAt      DateTime?
  // このRoomに対しfetchTiktokProfile()を最後に実行した時刻(結果を問わず)。
  // 同じ部屋への過度な再チェックを防ぐクールダウンと、候補選定の公平なローテーションに使う。
  lastExistenceCheckAt DateTime?

  // --- 低価値Room監視停止(tiktok-low-value-cleanup.ts)用 ---
  // このRoomに対し低価値クリーンアップの判定を最後に実行した時刻(結果を問わず)。
  // lastExistenceCheckAtと同じ理由(クールダウン+候補ローテーションの公平性)で持つ。
  // reviveSuspendedMonitoring()等の監視復帰処理からも現在時刻で書き込まれる——復帰直後
  // すぐ次の低価値判定サイクルの対象へ戻り再停止される事故を防ぐため(CHECK_COOLDOWN_MS)。
  lastLowValueCheckAt     DateTime?
  // --- 403/ブロック検知によるworker再割当(worker-guardian.ts)用 ---
  // TikTok側からの403応答(isBlockedError())が連続した回数。connectAndAttach()の
  // 接続失敗時・conn.on("error")時にrecordBlockedAttempt()がincrementし、
  // persistState()がstatus="connected"到達時に0へリセットする(notFoundStreakと
  // 同じCASE式パターン)。worker-guardian.tsがこの値の閾値超過を検知して別workerへの
  // 再割当を行う。全workerを試し尽くしても解消しなければmonitoringSuspended:trueにして
  // give-upし、以降はreviveSuspendedMonitoring()経由の復帰でこの値も0に戻る。
  consecutiveBlockedCount Int       @default(0)
  // true の間、watchedRoomFilter() はこのRoomの Streamer を「監視対象」から除外する
  // (Worker接続を維持しない)。**データは一切削除しない** — Streamer/
  // overlayToken/apiKey/Gift/BattleHistory はすべてそのまま残る。ユーザーが再ログイン/
  // 再アクセスすると markLastActive() が自動でfalseへ戻し、次のreconcileで監視が復活する。
  monitoringSuspended     Boolean   @default(false)

  // TikTokの不変な数値ID(api-live/user/room/ の data.user.id、バトルpayloadのanchorIdStr)。
  // **room の同一性はこの列で定義する**(ハンドルではない)。登録ゲート
  // (requireExistingTiktokAccount)が実在確認の応答から得た値を room 作成時に必ず渡すので
  // NOT NULL。後から埋める backfill(旧 tiktok-host-id.ts)は廃止した。
  hostTiktokUid String    @unique
  // 接続直前の uid 照合(tiktok-listener.ts)で「この room の tiktokHandle が別人のものになった」
  // と判定した時刻。立っている間は接続せず、削除候補判定(suspendNotFoundRoom)からも外す。
  // hostProfiles 観測または本人の再登録でハンドルが更新されたら null に戻す。
  handleStaleAt DateTime?

  streamers             Streamer[]
  gifts                 Gift[]
  listenerComments      ListenerComment[]
  battles               TiktokBattle[]
  battleItemUses        TiktokBattleItemUse[]
  battleBonusMissions   TiktokBattleBonusMission[]
  battleArmiesSnapshots TiktokBattleArmiesSnapshot[]
  battleTapPoints       TiktokBattleTapPoint[]
  battleHistories       BattleHistory[]
  watches               AgencyWatch[]
  monitorLeases         RoomMonitorLease[]
  connectionIntervals   RoomConnectionInterval[]

  // getMyRooms()の「担当workerId かつ (購読者あり または monitorUntilが未来)」検索用。
  // 期限切れの監視要求が蓄積しても30秒ごとのreconcileが重くならないようにする。
  @@index([workerId, monitorUntil])
  // tiktok-room-cleanup.tsの候補抽出クエリ用(listenerStatus + unhealthySince の複合条件)。
  @@index([listenerStatus, unhealthySince])
  // 運用調査用(psqlからハンドルで引く)。**アプリコードの同一性判定には使わない**。
  @@index([tiktokHandle])
  @@schema("public")
}

// /admin/workers管理画面からの完全削除・監視解除(一時停止)の監査ログ。
// 既存の監査ログ3種(worker-guardian/tiktok-room-cleanup/tiktok-low-value-cleanup)は
// AppSettingにJSON配列をtrimして保存する方式だが、完全削除の記録はtrimで失われては
// ならない(不可逆操作の唯一の事後追跡手段のため)ので専用テーブルを新設する。
model TiktokRoomAdminAuditLog {
  id            String   @id @default(cuid())
  action        String // "delete" | "suspend" | "toggle_special_watch"
  roomId        String // 削除後はTiktokRoom自体が無いのでFKは張らない(論理参照)
  tiktokHandle  String // 削除後にroomIdだけでは何のRoomか分からなくなるため必須保持
  operatorEmail String // getAdminSession()経由のセッションemail(ADMIN_EMAIL固定だが将来の複数管理者化に備え記録)
  detail        Json? // 削除時: { streamerCount, watchCount, agencyIds, giftCount, battleHistoryCount }
  createdAt     DateTime @default(now())

  @@index([roomId])
  @@index([createdAt])
  @@map("tiktok_room_admin_audit_logs")
  @@schema("public")
}

// Roomの監視理由を独立管理する(TiktokRoom.monitorUntilの単一値では
// EVENT監視とCOLLAB監視が同じroomへ同時発行された場合に競合・誤解放しうるため新設)。
//
// **release操作は必ずreason+referenceIdで絞り込むこと。** roomId単独で操作すると
// 他reasonのleaseを誤って消してしまう。
//
// referenceIdはEVENT用途では既存Event.id。COLLAB用途は**決定的な値**にする
// (例: `${selfRoomId}:${counterpartTiktokUid}`)。内部採番の乱数idにしない —
// 別Workerが同一コラボを両側から検知した場合でも、upsertが同じキーへ収束するようにするため。
//
// 移行期間中はTiktokRoom.monitorUntilへのデュアルライトを維持する(euler-usage.ts /
// tiktok-low-value-cleanup.ts / worker-status.tsの既存の読み手3箇所が動き続けるように)。
model RoomMonitorLease {
  id          String    @id @default(cuid())
  roomId      String
  reason      String // "EVENT" | "COLLAB"
  referenceId String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  releasedAt  DateTime? // null=有効

  room TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, reason, referenceId])
  @@index([roomId, releasedAt, expiresAt])
  @@map("room_monitor_leases")
  @@schema("public")
}

// Room/listenerの接続区間ログ(Battle非依存の汎用観測)。バトル確定処理の
// captureStatus/captureCoverage算出(RoomConnectionIntervalの区間unionをbattle windowに
// 重ねて被覆率を出す)に使う。
//
// endedAt:nullは「接続中」を表すが、Worker crash等でこの行が更新されなくなる可能性があるため
// lastHeartbeatAtを持つ。coverage算出時、lastHeartbeatAtが閾値(例: 90秒)を超えて更新停止していれば
// その時刻で打ち切ったものとして扱う(でないとcrash後のバトルが偽の100%coverageになる)。
model RoomConnectionInterval {
  id               String    @id @default(cuid())
  roomId           String
  startedAt        DateTime
  endedAt          DateTime?
  disconnectReason String?
  lastHeartbeatAt  DateTime  @default(now())

  room TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startedAt])
  @@index([roomId, endedAt])
  @@map("room_connection_intervals")
  @@schema("public")
}

// EulerStream署名API(WebSocket接続用の署名)への実際のリクエストを1回につき1行記録する。
// 「謎のAPIトークン消費」の原因究明用。
//
// **記録境界は `conn.connect()` ではなく、tiktok-live-connectorが実際に
// `fetchSignedWebSocketFromEuler` を呼ぶ瞬間(`signedWebSocketProvider`)。**
// `conn.connect()` は fetchRoomInfoOnConnect のオフライン判定(UserOfflineError)で
// 署名取得前に終わることがあり、そちらまで1行にすると「オフライン配信者への
// 30秒ごとの再試行」が大量に紛れ込み、実際のトークン消費と一致しなくなる。
model EulerSignUsage {
  id          String   @id @default(cuid())
  // 署名リクエストを開始した時刻。fire-and-forgetでDB書き込みが遅延すると
  // createdAt(INSERT完了時刻)とずれるため分けて持つ。
  requestedAt DateTime
  createdAt   DateTime @default(now())

  roomId       String
  tiktokHandle String

  outcome      String // "success" | "error"
  errorMessage String? @db.Text // outcome="error"のときだけ

  // connectInstance()がどの経路から呼ばれたか。
  // "start"(初回接続 / reconcileでの復元) | "scheduled_reconnect"(disconnected等からの通常再接続) | "watchdog"(無応答検知による強制再接続)
  trigger String
  // scheduleReconnect()のreason。trigger="scheduled_reconnect"のときだけ意味を持つ。
  // ("disconnected" | "stream_end" | "error" | "rate_limited" | "connect_failed" | "user_offline")
  reason  String?

  role             String // "web" | "worker"
  workerIndex      Int?
  // fencing用のプロセス世代(ListenerEpoch.id)。ゼロダウンタイムデプロイ中に
  // 新旧Workerが同じ部屋へ並走したことを見分けるため。
  listenerEpoch    BigInt?
  // 記録時点でDB上どのWorkerがこの部屋の担当だったか(TiktokRoom.workerId)。
  // 上のworkerIndexと食い違っていれば、担当替え直後の旧Workerが取り残されて
  // 接続していることが分かる。
  assignedWorkerId Int?
  // EulerAPIキーが設定されていたか。匿名取得は別のトークン消費経路として扱うため区別する。
  credentialMode   String // "configured" | "anonymous"

  // 記録時点のスナップショット。FK無し(部屋やイベントが後で消えても履歴は残す)。
  // 表示名は現在のテーブルからしか解決できない — 削除・改名後は当時と異なりうる。
  streamerPrincipalIds String[]
  agencyIds            String[]
  eventIds             String[]
  roomMonitorUntil     DateTime? // 記録時点のTiktokRoom.monitorUntil

  @@index([roomId, createdAt])
  // 署名を実際に要求したハンドルの記録(観測事実のログ)。改名後は過去分が引けなくなるが、
  // それがこのログの正しい意味。
  @@index([tiktokHandle, createdAt])
  @@index([createdAt])
  @@schema("public")
}

// listener状態の書き込みをフェンスするための世代番号。
//
// プロセス起動時に1行 insert し、採番された id をそのプロセスの世代として使う。
// **後から起動したプロセスほど必ず大きい値になる**ことだけが要件で、壁時計に依存しない
// (複数コンテナ間でNTPずれがあっても順序が壊れない)。
//
// 1デプロイあたりWorker数ぶんしか増えないので、行数は年に数百のオーダー。
model ListenerEpoch {
  id          Int      @id @default(autoincrement())
  // どのプロセスが取った世代か。障害時の追跡用で、判定には使わない。
  role        String? // "worker" | "web"
  workerIndex Int?
  startedAt   DateTime @default(now())

  @@schema("public")
}

// TiktokIdMergeJob / TiktokIdMergeLog は 2026-09 の識別子統一リファクタリングで削除した。
// room の一意キーがハンドルから hostTiktokUid へ移り、改名しても room が割れなくなったため
// 「事後にroomを合流させる」機構(src/lib/tiktok-id-migration.ts)そのものが不要になった。

// 事務所・企業向けのアカウント。配信者本人(Streamer)とは独立していて、
// 自分ではTikTok IDを持たず、監視対象(AgencyWatch)を通してのみデータを参照する。
//
// Userではなくemailを識別子にしている。管理者が相手のGoogleアカウントのメールアドレスを
// 先に登録し、本人がそのアカウントでログインした時点で使えるようにするため
// (ログイン前はUser行が存在しないので、principalIdでは紐づけられない)。
// 事務所が存在すること自体が利用許可であり、別途の承認フラグは持たない。
model Agency {
  id              String   @id @default(cuid())
  email           String   @unique // 管理者が登録したGoogleアカウント。小文字に正規化して保存する
  name            String
  // 企業向けAPIキーはSHA-256ハッシュで保存する(Streamer.apiKeyの平文保存は踏襲しない)。
  // 参照は常にキー本体のハッシュで引くため、平文を持たなくても認証できる。
  apiKeyHash      String?  @unique
  maxWatchTargets Int      @default(10) // 監視対象の上限。1件ごとにTikTok接続とproxy枠を消費するため必須
  createdAt       DateTime @default(now())

  watches AgencyWatch[]

  @@schema("public")
}

// 事務所が監視対象に指定したライバー。ギフトデータはTiktokRoom単位で共有されるため
// roomIdで紐づける(Streamerと同じ設計)。tiktokHandleは事務所の入力値そのままを表示用に保持し、
// 正規化済みの値はTiktokRoom側だけが単一の正として持つ。
// 配信者本人の登録(Streamer)は必要なく、Streamerが0人でもwatchがあればWorkerが接続する。
model AgencyWatch {
  id           String   @id @default(cuid())
  agencyId     String
  roomId       String
  // 登録ゲート(requireExistingTiktokAccount)が実在確認の応答から得た不変ID。監視対象の指定はこれで行う
  tiktokUid    String
  tiktokHandle String // 表示用。ユーザー入力値そのまま
  label        String? // 事務所側の管理名(本名・所属チームなど)
  createdAt    DateTime @default(now())

  agency Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  room   TiktokRoom @relation(fields: [roomId], references: [id])

  @@unique([agencyId, roomId])
  @@index([roomId])
  @@schema("public")
}

model Streamer {
  id                    String    @id @default(cuid())
  principalId           String    @unique // sidestage の User.id
  // 登録ゲートが実在確認の応答から得た不変ID。room を消しても resolveRoomForStreamer() が
  // これを使って再作成できるようにするため、TiktokRoom とは別にここでも保持する(NOT NULL)。
  tiktokUid             String
  tiktokHandle          String // 表示用。ユーザー入力値そのまま(正規化はTiktokRoom側でのみ行う)
  verificationCode      String
  verified              Boolean   @default(false)
  verifiedAt            DateTime?
  apiKey                String?   @unique
  createdAt             DateTime  @default(now())
  // ユーザー操作(web /api/verify/generate, mobile PATCH /api/mobile/streamer)による
  // tiktokHandle 設定・変更の最終時刻。7日間の再変更ロックの起点に使う。
  tiktokHandleChangedAt DateTime?
  roomId                String? // 実際の接続・ギフトデータを共有するTiktokRoomへの紐付け

  overlayToken             String? @unique
  overlayDisplayReference  String  @default("today") // "today" | "fixed"
  overlayDisplayDate       String? // YYYY-MM-DD, overlayDisplayReference="fixed" のときのみ意味を持つ
  overlayThreshold         Int     @default(1000)
  overlayGoalCount         Int     @default(5)
  overlayVisibleRows       Int     @default(5) // この人数を超えたらスナップスクロール
  overlayNameMaxWidth      Int     @default(140) // px、これを超える名前は省略表示
  overlayAlign             String  @default("left") // "left" | "right"
  overlayHeadingBackground String  @default("clear") // "clear" | "crystal-blue" | "sakura-pink"
  overlayDisplaySpeed      Int     @default(3) // 1(遅い)〜5(速い)、スナップスクロールと全体縮小表示の待機時間を制御

  user User        @relation(fields: [principalId], references: [id], onDelete: Cascade)
  room TiktokRoom? @relation(fields: [roomId], references: [id])

  // desktopの5ウィジェット移植で追加。既存のoverlay*列(contribution専用)とは分離し、
  // 種類ごとに1テーブルへ寄せてある(Streamerへ列を積み増し続けると肥大化するため)。
  overlayCoinListSettings         OverlayCoinListSettings?
  overlayTopGiftSettings          OverlayTopGiftSettings?
  overlayTapListSettings          OverlayTapListSettings?
  overlayLikeContributionSettings OverlayLikeContributionSettings?
  overlayTimerSettings            OverlayTimerSettings?
  overlayTimerState               OverlayTimerState?

  @@index([roomId])
  @@schema("public")
}

// TikTokの「いいね」日次累計。単発イベントのログは保持しない方針
// (like-contribution/tap-listウィジェットの要件: 累積カウンタのみで十分)。
// GiftとおなじくroomId単位で共有される(同じTikTokアカウントを複数Streamerが登録していれば
// 同じ行を参照する)。likeイベント自体には金銭的価値がなく再送/重複の実害が
// Giftより小さいため、Giftのような(roomId, orderId)unique制約やmsgId時間窓dedupまでは持たない
// — 増分はWorker側の秒単位コアレッシング+プロセス内msgId FIFOでのみ弾く。
model OverlayCoinListSettings {
  streamerId   String   @id
  fontKey      String   @default("default")
  textStyleKey String   @default("gold-night")
  strokeWidth  Int      @default(4)
  bgStyle      String   @default("transparent") // "transparent" | "semi"
  sortOrder    String   @default("desc") // "asc" | "desc"
  maxEntries   Int      @default(20) // 1-100
  rowGap       Int      @default(8)
  updatedAt    DateTime @updatedAt

  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("overlay_coin_list_settings")
  @@schema("public")
}

model OverlayTopGiftSettings {
  streamerId        String   @id
  fontKey           String   @default("default")
  textStyleKey      String   @default("gold-night")
  strokeWidth       Int      @default(4)
  title             String   @default("本日最高ギフト")
  senderDisplayMode String   @default("latest") // "latest" | "all"
  glowEnabled       Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("overlay_top_gift_settings")
  @@schema("public")
}

model OverlayTapListSettings {
  streamerId   String   @id
  fontKey      String   @default("default")
  textStyleKey String   @default("gold-night")
  strokeWidth  Int      @default(4)
  bgStyle      String   @default("transparent")
  maxEntries   Int      @default(20)
  rowGap       Int      @default(8)
  updatedAt    DateTime @updatedAt

  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("overlay_tap_list_settings")
  @@schema("public")
}

model OverlayLikeContributionSettings {
  streamerId       String   @id
  fontKey          String   @default("default")
  textStyleKey     String   @default("gold-night")
  strokeWidth      Int      @default(4)
  title            String   @default("Likeありがとう！")
  interval         Int      @default(50)
  soundVolume      Int      @default(100)
  balloonDesignKey String   @default("dark-glass")
  countFontSize    Int      @default(42)
  nameFontSize     Int      @default(34)
  updatedAt        DateTime @updatedAt

  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("overlay_like_contribution_settings")
  @@schema("public")
}

// タイマーオーバーレイの設定。1配信者(Streamer)につき1行。
// desktopのtimer-state.js DEFAULT_TIMER_SETTINGSを踏襲。音源は任意URLではなく
// プリセットキーで持つ(OBSブラウザソースに外部URLを無条件fetchさせないため。
// src/lib/overlay/sound-presets.ts 参照)。
model OverlayTimerSettings {
  streamerId String @id

  durationMinutes Int    @default(10) // start/reset時の初期値(分)
  durationSeconds Int    @default(0) // start/reset時の初期値(秒、0-59)
  headingText     String @default("カウントダウン")

  endSoundKey    String? // sound-presets.tsのキー。nullは無音
  endSoundVolume Int     @default(100) // 0-100

  minFloorMinutes   Int @default(0) // 短縮下限(分)。0=無制限に短縮可
  maxCeilingMinutes Int @default(0) // 延長上限(分)。0=無制限に延長可

  countdownSoundEnabled          Boolean @default(false)
  countdownSoundThresholdSeconds Int     @default(5)
  countdownSoundKey              String?
  countdownSoundVolume           Int     @default(100)

  fontKey      String @default("default")
  textStyleKey String @default("gold-night")
  strokeWidth  Int    @default(4)

  updatedAt DateTime @updatedAt

  streamer  Streamer               @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  giftRules OverlayTimerGiftRule[]

  @@map("overlay_timer_settings")
  @@schema("public")
}

// ギフト連動: 「このギフト名を受け取ったら±分数」のマッピング。複数登録可能。
// 一致キーはgiftIdではなく名前(trim+小文字化) — 既存のギフト照合規約に合わせる。
model OverlayTimerGiftRule {
  id           String   @id @default(cuid())
  streamerId   String
  giftName     String // trim+小文字化済みで保存
  minutesDelta Float // 1コンボ単位あたりの加減算量(分)。マイナスで短縮
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())

  settings OverlayTimerSettings @relation(fields: [streamerId], references: [streamerId], onDelete: Cascade)

  // streamerId単位のルール件数は少数(多くて数十件)想定のため、
  // (streamerId, enabled)の追加indexは持たない — @@uniqueのprefixで十分。
  @@unique([streamerId, giftName])
  @@map("overlay_timer_gift_rules")
  @@schema("public")
}

// タイマーの実行時状態。running/endsAt/remainingMsのみを永続化する。
// 発火(終了音等)はサーバーのsetTimeoutではなくクライアント側のローカル計算で行うため、
// ここにはタイムアウトハンドル相当の状態は一切持たない。
model OverlayTimerState {
  streamerId  String    @id
  running     Boolean   @default(false)
  endsAt      DateTime? // running=trueのときのみ意味を持つ(絶対時刻)
  remainingMs Int       @default(0)
  updatedAt   DateTime  @updatedAt

  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("overlay_timer_state")
  @@schema("public")
}

model AppSetting {
  key       String   @id
  value     String?  @db.Text
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model Gift {
  id              String   @id @default(cuid())
  roomId          String // TikTokアカウント単位で共有(同じ配信者を登録した全ユーザーが同じ行を参照)
  // 送信者の不変ID。表示名(ハンドル・ニックネーム・アイコン)はここから TikTokUser を順引きする
  // ので、この行には保存しない(改名しても集計が割れない)。
  tiktokUid       String
  giftId          Int
  giftName        String
  giftPictureUrl  String?
  repeatCount     Int      @default(1)
  diamondCount    Int      @default(0)
  totalDiamonds   Int      @default(0)
  receivedAt      DateTime @default(now())
  timeSource      String   @default("tiktok") // "tiktok" | "fallback" — fallback は TikTok createTime 欠落/不正でサーバー受信時刻を使用したことを示す
  dayKey          String
  orderId         String?
  groupId         String?
  // TikTok common.msgId。protobufの既定値"0"等、実IDとして使えない値は resolveMsgId() が null にする。
  // dedupキー。saveGift() が「直近5分に同じ (roomId, msgId) があるか」を引くのに使う
  // (@@index([roomId, msgId]))。**unique制約は張らない** — roomIdは配信セッション
  // ではなく永続的なTiktokRoom.idなので、将来の別ライブでmsgIdが再利用されたら正当なギフトを
  // 恒久的に弾いてしまう。加えて prisma db push は Dockerfile の CMD でコンテナ起動時に走るため、
  // 既存の重複行があるとunique index作成に失敗してWebが起動しなくなる。
  msgId           String?
  // 1 = combo可能ギフト。groupId="0" が3591件流入していて、それが実際にcomboなのか
  // 単発ギフトなのかを本番DBだけでは判定できないため、combo キーの設計見直し用に残す。
  giftType        Int?
  // WebcastGiftMessage.matchInfo(shared/tiktok-live-connectorのfork改造で取得可能になった
  // バトルアイテム効果の刻印)。multiplierType=0は「倍率なし」を明示する値で、未観測(旧データ・
  // 取得失敗)はnullのまま区別する。BATTLE-EVENTS.mdのMultiplierType enum: 1=CRITICAL_STRIKE(グローブ crit)
  // / 2=TOP_2 / 3=TOP_3 / 4=VAULT_GLOVE_CRITICAL_STRIKE(fork独自追加)。
  multiplierType  Int?
  multiplierValue Int?

  room TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, orderId])
  @@index([roomId, dayKey])
  @@index([roomId, receivedAt])
  @@index([roomId, tiktokUid])
  @@index([roomId, groupId])
  @@index([roomId, msgId])
  // 90日retentionの削除バッチは dayKey 単体で絞る(gift-retention.ts)。既存のindexは
  // すべて roomId 先頭なので、これが無いと日次の削除が gifts のフルスキャンになる。
  @@index([dayKey])
  @@map("gifts")
  @@schema("public")
}

// リスナーコメント(chat)の生ログ。将来のAIによるコメント傾向分析用途で保存する。
// **受信から30日で自動削除される**(listener-comment-retention.ts)。Giftと違い
// 金銭的価値を持たず流量もはるかに多いため、削除前のロールアップ集計は行わない
// (分析要件が未確定な段階で集計テーブルを固定すると、要件変更のたびに壊れるため)。
//
// unique制約は張らない。Gift同様の理由: roomIdは配信セッションではなく永続的な
// TiktokRoom.idで、将来msgIdが再利用されると正当なコメントを恒久的に弾みうる。
// 加えて prisma db push はコンテナ起動時に走るため、既存の重複行があると
// unique index作成に失敗してWebが起動しなくなる。
//
// profileImageUrlは持たない。TikTokのプロフィール画像URLは署名付きで数十時間で
// 失効し(avatar-storage.tsの再保存を経ないと恒久表示できない)、この用途は
// テキスト分析が主眼で画像表示を要さないため。
model ListenerComment {
  id         String   @id @default(cuid())
  roomId     String
  // 投稿者の不変ID。表示名は TikTokUser から順引きする(§2.1)。
  tiktokUid  String
  comment    String
  receivedAt DateTime @default(now())
  timeSource String   @default("tiktok") // "tiktok" | "fallback"。Gift同様、TikTok createTime欠落/不正時はサーバー受信時刻を使う
  dayKey     String
  // TikTok common.msgId。resolveMsgId()がprotobufの既定値等をnullにする。
  // インメモリdedup(rememberMsgId, tiktok-listener.ts)が正常系の重複をほぼ弾いており、
  // DB側の事前重複チェックは行わない(chat流量はgiftよりはるかに多く、都度のfindFirstは
  // 書き込み負荷に見合わない。多少の重複が残ってもAI傾向分析用途では実害が軽微)。
  msgId      String?

  room TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, dayKey])
  @@index([roomId, receivedAt])
  // 30日retentionの削除バッチは dayKey 単体で絞る(listener-comment-retention.ts)。
  // 他のindexは全部roomId先頭なので、これが無いと削除がフルスキャンになる。
  @@index([dayKey])
  @@map("listener_comments")
  @@schema("public")
}

// ギフト明細(Gift)の日次ロールアップ。(roomId, dayKey, tiktokUid) 単位。
//
// **Gift は受信後90日で削除される**(gift-retention.ts)。削除しても期間ランキング・
// 事務所APIの長期集計が壊れないよう、削除の前にこのテーブルへ集計を落としておく。
// こちらは長期保持(削除しない)。
//
// **Gift への FK は張らない**(BattleHistoryGiftEvent と同じ「コピーして切り離す」パターン)。
// roomId も論理参照に留める — TiktokRoom の物理削除時は deleteTiktokRoomPermanently() が
// 同一トランザクションで明示的に削除し、TikTok ID 自動合流時は absorbRooms() が
// 新 roomId へ合算して付け替える。
//
// rowCount は「行数」で、giftCount(= repeatCount の合計)とは意味が違う。
// login-stats が現行どおり行数ベースの数字を出せるよう GiftLifetimeStat.rowCount を
// ここから再集計するために必要。
model GiftDailyListenerStat {
  id        String @id @default(cuid())
  roomId    String
  dayKey    String
  tiktokUid String

  rowCount      Int @default(0) // Gift の行数
  giftCount     Int @default(0) // Gift.repeatCount の合計
  totalDiamonds Int @default(0) // Gift.totalDiamonds の合計(1日1人ぶんなのでIntで足りる)

  firstReceivedAt DateTime
  lastReceivedAt  DateTime

  @@unique([roomId, dayKey, tiktokUid])
  @@index([roomId, dayKey])
  @@index([dayKey])
  @@map("gift_daily_listener_stats")
  @@schema("public")
}

// tiktokUid 単位(room横断)の全期間累計。GiftDailyListenerStat 全体から毎回再集計する。
// /api/public/login-stats の gifts フルスキャンを置き換えるためだけに存在する。
//
// totalDiamonds は全期間・全room の合計なので Int を超えうる。BigInt で持つ。
model GiftLifetimeStat {
  tiktokUid String @id

  rowCount      Int    @default(0) // Gift の行数(prisma.gift.count() 相当)
  giftCount     Int    @default(0) // Gift.repeatCount の合計
  totalDiamonds BigInt @default(0)

  firstSeenAt DateTime
  lastSeenAt  DateTime

  @@map("gift_lifetime_stats")
  @@schema("public")
}

// TikTokの全ギフトカタログ(webcastの `gift/list/` の結果)。全部屋で共有する1枚のテーブル。
// ギフトはほぼグローバルなので部屋ごとには持たない(部屋限定ギフトは和集合として混ざる)。
//
// **効果音の一致キーはgiftIdではなく名前。** gift/list/ は同じ名前に複数のgiftIdを割り当てており
// (実測670件中29名が重複)、giftId自体もレスポンス内で重複する(実測4行)。giftId照合にすると
// 同名の別IDを取りこぼすうえ、ピッカーに区別のつかない同名行が並ぶ。
// giftIdを主キーにしているのはカタログを素直な鏡として持つためだけで、
// 消費側(GET /api/mobile/gifts)は name で畳んでコイン数の範囲に集約して返す。
//
// upsertのみで削除はしない。したがって実体は「現在のカタログ」ではなく
// **「これまでに観測したカタログの和集合」**になる。候補一覧を出すのが目的なので意図的にそうしている
// (TikTok側のA/Bやproxyの地域差で一時的に欠けたギフトを消したくない)。
model TiktokGiftCatalog {
  giftId       Int      @id // gift/list/ の gift.id
  name         String // 一致キー。trim + 小文字化済み(chat:giftのgiftNameと同じ正規化)
  label        String // 表示用。カタログの元表記(英語)
  // TikTok公式の日本語表示名。`webcast_language=ja-JP` で叩いた gift/list/ から採る。
  // **表示専用。一致キーには使わない**(LIVEのgiftイベントは英語で来るため)。
  // 日本語版の取得に失敗した場合や、日本語環境でも英語表記のギフト以外で埋まらない場合は null。
  // 一時的な取得失敗で消えないよう、upsert時は COALESCE で既存値を守る。
  labelJa      String?
  diamondCount Int      @default(0)
  // ギフトのアイコン。gift/list/ の `image.url_list` から isAllowedAvatarUrl() を通ったURLだけを入れる。
  // avatar と違って**署名(x-expires)が付かないので永続化しても腐らない**。取れなければ null。
  imageUrl     String?
  fetchedAt    DateTime @default(now()) // 最後にカタログから見た時刻。TTL判定に使う。**upsert時に明示更新する**

  @@index([name])
  @@map("tiktok_gift_catalog")
  @@schema("public")
}

// TikTokのバトル(LinkMic Battle)の観測記録。イベントの対戦自動検知が使う。
// analytics自身はこのデータを使わないが、バトル中かどうかはWebcastのイベントでしか
// 分からないので受信側で残しておく。
//
// **1つのバトルについて、参加した両サイドのroomからそれぞれ同じbattleIdのイベントが届く。**
// (両方をこちらが監視している場合)。したがってbattleIdでグループ化すれば
// 「そのバトルに誰が参加したか」がpayloadの解釈精度に依存せず分かる。
// 相手のTikTokハンドルはpayloadに含まれないため、この照合が唯一の確実な手段。
model TiktokBattle {
  id       String @id @default(cuid())
  roomId   String
  battleId String // TikTokのbattleId。API上stringなので数値化しない
  action   Int // 最後に観測したBattleAction(OPEN=4 / FINISH=5 / CUT_SHORT=6)

  startedAt          DateTime
  // startedAtが受信時刻からの推定値か。接続はprocessInitialData:falseなので配信の
  // 途中から繋ぐと開始(OPEN)を取り逃す。BattleSetting.startTimeMsも取れなかった場合、
  // startedAtは「気づいた時刻」でしかない。イベント側の照合はこれを見て信頼度を決める。
  startedAtEstimated Boolean  @default(true)

  endedAt        DateTime?
  durationSec    Int? // BattleSetting.duration(秒)。終了を取り逃したときの終了時刻の推定に使う
  hostTiktokUids String[]  @default([]) // tiktokUid(TLC raw の anchorIdStr。数値文字列)
  hostDisplayIds String[]  @default([]) // anchorInfo[].user.displayId(ハンドル相当・実データで検証済み。ただしhostTiktokUidsとインデックス対応しない)
  hostScores     Json      @default("{}") // tiktokUid -> hostScore(stringのまま)
  // tiktokUid -> {displayId, avatarUrl}。tiktok-battle.tsのHostProfiles。
  // **nickName は持たない** — 表示名の正本は TikTokUser で、hostProfiles 観測時に recordTikTokUser() が記録する。
  hostProfiles   Json      @default("{}")
  hostTeams      Json      @default("{}") // tiktokUid -> teamId(teamArmies由来。1vs1等チーム情報が無いバトルは{})
  // tiktokUid -> OpponentWatchEntry(tiktok-battle.tsのOpponentWatch)。相手roomの監視が
  // どの経路(コラボ承諾/バトル開始補助/元々監視中/失敗)で始まったかの記録。表示には使わず、
  // コラボ承諾トリガー(recordCollabGroupChange)の取りこぼし率を事後検証するためだけの記録。
  opponentWatch  Json      @default("{}")

  // このroomでこのバトルのタップ点(TiktokBattleTapPoint)を**バトル開始から取りこぼしなく**
  // 観測できたか。true のときだけ初ギフトx倍の逆算がタップ点を差し引く。
  //
  // **「タップ点0件」と「未計測」を混同しないための列。** false のバトルは差し引きを行わず、
  // タップ計測導入前と完全に同じ判定になる(既定値がfalseなので過去分は自動的にそうなる)。
  //
  // 書き込みはバトル終了時の最終化タスク1本だけ(tiktok-listener.ts)。途中の失敗はメモリ上の
  // フラグを落とすだけでDBは触らない。二経路で書くと、FINISH後にreject したinsertのfalseを
  // 後から走るtrueが上書きしうる。
  tapPointsTracked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, battleId])
  @@index([roomId, startedAt])
  @@index([battleId])
  @@map("tiktok_battles")
  @@schema("public")
}

// バトル中のアイテム使用ログ(グローブ/ハンマー/ブースター/金グローブ)。1回の使用=1行。
// TiktokBattleが「現在のバトル状態」を1行に集約するのに対し、こちらは時系列の離散イベント。
//
// **battleIdへFK制約は張らない。** TiktokBattle行の作成前(バトル開始検知の取りこぼし・受信順序)
// にアイテム使用イベントが先着することがあり、Giftと同じ「roomId経由の緩い関連付け」思想を踏襲する。
model TiktokBattleItemUse {
  id       String @id @default(cuid())
  roomId   String
  battleId String // TikTokのbattleId。TiktokBattle.battleIdと同じ文字列だが直接のFKは張らない

  // WebcastLinkMicBattleItemCard.cardType(shared/tiktok-live-connectorのBattleItemCardType)
  // 2=glove / 6=hammer / 10=top2booster / 11=top3booster / 12=vaultGlove。
  // POWER_UP_SUMMARY(4、周期通知でsenderなし)は保存対象外(ハンドラ側でスキップ)。
  cardType Int

  // 送信者の不変ID。表示名は TikTokUser から順引きする(§2.1)。
  senderTiktokUid         String
  senderProfilePictureUrl String?
  targetHostTiktokUid     String // 使用対象の配信者のtiktokUid

  // TikTok common.msgId。resolveMsgId()が既定値"0"等を弾いてnullにする。
  // dedupは(roomId, msgId)の5分window方式(Gift/saveGiftと同じ思想。理由はtiktok-listener.tsのGIFT_DEDUP_WINDOW_MS参照)。
  msgId String?

  receivedAt DateTime @default(now())

  room TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, battleId])
  @@index([roomId, msgId])
  @@map("tiktok_battle_item_uses")
  @@schema("public")
}

// バトル中盤のボーナスミッション区間(linkMicBattleTask、taskStart→taskUpdate×n→taskSettle→
// [報酬区間]→rewardSettleのライフサイクル)。taskUpdate(進捗)は高頻度なため保存しない。
//
// **battleIdへFK制約は張らない**(TiktokBattleItemUseと同じ理由)。
//
// rewardSumは**observing roomごとの値**(BATTLE-EVENTS.mdに明記の通り「そのルームが区間中に
// 獲得したボーナスpt合計」)。TiktokBattleと同じく、両サイドを監視している場合は別行として届く。
model TiktokBattleBonusMission {
  id       String @id @default(cuid())
  roomId   String
  battleId String

  targetType     Int // 1=人数系 / 2=実弾pt系 / 8=チーム戦pt系(taskPeriodConfig.targetType)
  progressTarget Int
  rewardMultiple Int // 2 or 3

  startedAt       DateTime // taskStart受信時刻
  settledAt       DateTime? // taskSettle受信時刻
  taskResult      Int? // 0=中間settle / 1=未達成 / 2=達成
  rewardStartedAt DateTime? // 報酬区間開始目安
  rewardEndedAt   DateTime? // rewardSettle受信時刻(区間終了の正)
  rewardSum       Int? // rewardSettle.sum相当。observing roomごとの値

  room TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, battleId])
  @@map("tiktok_battle_bonus_missions")
  @@schema("public")
}

// linkMicArmies受信の都度追記する時系列スコアスナップショット。TiktokBattle.hostScores
// (最新値への累積上書き、mergeBattleStateで増える方向のみマージ)と異なり、
// 「初ギフトx倍」区間の逆算(ギフトのdiamondCountとスコア増分を突き合わせる、BATTLE-EVENTS.md
// 4節)の入力として時系列を残す。
//
// **2026-09-07に方針変更**: 以前はここに「確定後は逆算結果のみが恒久化対象で、このテーブル自体は
// BattleHistory側へ複製しない」と書いていたが、バトル再生機能ではスコア曲線そのものが表示対象に
// なったため、確定時に自roomのwindow内スナップショットを BattleHistoryScorePoint へ複製する。
model TiktokBattleArmiesSnapshot {
  id         String   @id @default(cuid())
  roomId     String
  battleId   String
  occurredAt DateTime @default(now())
  tiktokUid  String // スコア主体。1vs1はbattleItems[].userArmy[]単位、チーム戦はteamArmies[].teamUsers[]単位
  score      String // 累積スコア。桁数が大きいためString(BattleHistoryParticipant.scoreと同じ理由)

  room TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, battleId, occurredAt])
  @@map("tiktok_battle_armies_snapshots")
  @@schema("public")
}

// バトル中のタップ点(いいね由来のスコア)。**1リスナーが10タップに到達した瞬間に1行**立つ。
// 上限は1リスナー1バトル1回で、次のバトルでは全員が再び権利を得る。毎秒書く方式ではない。
//
// 公式スコアはギフトだけでは増えず「ギフト点 x 倍率 + タップ点」なので、これを差し引かないと
// 初ギフトx倍の逆算(battle-opening-multiplier.ts)の ratio が一方向に上振れし、正しい倍率が
// 「判定不能」として棄却される(本番実例: 406/200 = 2.03 が RATIO_TOLERANCE 0.02 を超えて棄却)。
//
// **battleIdへFK制約は張らない**(TiktokBattleItemUse / TiktokBattleBonusMission と同じ理由。
// イベント先着で TiktokBattle 行が未作成のことがある)。
model TiktokBattleTapPoint {
  id       String @id @default(cuid())
  roomId   String
  battleId String

  // このroomの配信者のtiktokUid(TikTokの数値ID文字列。DBのUUIDではない)。
  // **読み出し時に room -> host を解決しないための列。**
  hostTiktokUid String

  // 10タップ目のlikeを受信した時刻。**@default(now()) にしない** — insertはfire-and-forgetなので
  // now()は挿入時刻になり、write queueの詰まりの分だけ後ろへずれる。区間割当の精度が
  // そのまま逆算の正しさになる。
  occurredAt DateTime

  tiktokUid String // 10タップに到達したリスナー(不変ID。表示名は TikTokUser から順引き)
  points    Int // 現行仕様では常に3。仕様が違っていたと後で判るよう定数で埋めずに保存する

  room TiktokRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // **「1リスナー1バトル1回」の仕様そのもの。** 再接続でメモリ上の重複防止(reached Set)が
  // 消えても二重計上できない。書き込みは createMany({ skipDuplicates: true })。
  @@unique([roomId, battleId, tiktokUid])
  // 先頭はroomIdではなくbattleId。loadTapPointsForBattleは1つのbattleIdに対して
  // 自room・相手roomを横断して引く(armies snapshotが自roomだけを引くのと条件が違う)。
  @@index([battleId, roomId, occurredAt])
  @@map("tiktok_battle_tap_points")
  @@schema("public")
}

// バトル履歴タブの確定スナップショット(非正規化キャッシュ)。
//
// バトル履歴タブは本来 TiktokBattle から時間窓を求め、その都度 Gift を集計している。
// バトル終了から30秒後、値が60秒間安定していたことを実測で確認できた場合にだけ、その集計結果を
// ここへ1回だけ確定保存し、以後の読み出しを Gift 非依存にする(src/lib/battle-history-finalize.ts)。
//
// **行が存在すること自体が「確定済み」を意味する。** 未確定バトルは行を作らないので、
// 読み出し側(src/lib/battle-history.ts)は行の有無だけで「確定テーブルを読む/ライブ集計へ
// フォールバックする」を判定できる(専用フラグは不要)。確定はあくまで最適化であり、
// 確定できなかったバトルの表示は従来どおりライブ集計で正しく出る。
//
// **avatarUrl 列は持たない。** resolveAvatarUrls が返すのは24時間で失効する署名付きURLなので、
// 文字列としてスナップショットすると翌日リンク切れになる。tiktokUid だけを保存し、
// 読み出し時に TiktokAvatarAsset から都度署名する(このテーブルは Gift 非依存の恒久キャッシュ)。
model BattleHistory {
  id       String @id @default(cuid())
  roomId   String
  battleId String

  windowStart DateTime // resolveBattleWindowが確定したstart
  windowEnd   DateTime // 同end(materializeはend!==nullの場合のみ実行するのでNOT NULL)
  status      String // "finished" | "cut_short"(resolveBattleWindowのstatus。liveは作らない)

  selfScore         String?
  opponentScore     String?
  selfTotalDiamonds Int      @default(0) // Gift.totalDiamondsと同じInt
  sourceUpdatedAt   DateTime // 集計に使った全room TiktokBattle行のupdatedAt最大値。新旧Worker並走時のCASに使う
  finalizedAt       DateTime // 確定処理を実行した時刻

  // 「初ギフトx倍」区間の逆算結果(TiktokBattleArmiesSnapshotとGiftのdiamondCountの突き合わせ)。
  // **1(倍率なしと判定できた) / 2 / 3 / null(判定不能)**。room非依存のバトル全体の値として1つ持つ
  // (陣営間で値が食い違う観測が出た場合はBattleHistoryParticipant単位への変更を検討)。
  // 以前は「2/3/null(判定不能または倍率なし)」で1とnullを区別していなかったが、再生UIが
  // 「倍率なし」と「わからない」を別の表示にするため2026-09-07に分離した。
  openingMultiplier            Int?
  // 判定に使ったGift.idの記録用。監査用途、FKは張らない。候補が複数あった場合は最初の候補
  // (occurredAtが最も早いもの)を入れる。
  openingMultiplierBasisGiftId String?
  // 逆算の確からしさ。"measured"(候補2件以上が全一致) / "inferred"(候補1件、または倍率刻印が
  // 未観測のため TOP_2/TOP_3 ブースターと区別できない) / "unknown"(候補なし・不一致)。
  // **再生UIの赤帯を出してよいのは "measured" のときだけ。**
  openingMultiplierConfidence  String?
  // 逆算に使った候補区間の実測範囲。**仮定値(60秒)からは書かない。** 実測できた場合のみ埋め、
  // 再生UIのカウントダウン表示はこの2列が揃っているときだけ出す。
  openingWindowStartedAt       DateTime?
  openingWindowEndedAt         DateTime?

  // 再生可否の判定材料。**replayReady のような真偽値は持たない**(判定条件は今後変わるため、
  // 件数だけ保存して判定は isReplayable() 1箇所に置く)。
  replayScorePointCount Int @default(0)
  replayGiftEventCount  Int @default(0)

  // 公開シェアリンクのトークン。Streamer.overlayTokenと同じ「平文・ハッシュ化なし・遅延発行」。
  // crypto.randomBytes(24)で生成する(cuid等の推測可能な識別子は使わない)。
  shareToken         String?   @unique
  shareTokenIssuedAt DateTime?

  room          TiktokRoom                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participants  BattleHistoryParticipant[]
  teams         BattleTeam[]
  bonusMissions BattleHistoryBonusMission[]
  scorePoints   BattleHistoryScorePoint[]

  @@unique([roomId, battleId])
  @@index([roomId, windowStart])
  @@map("battle_histories")
  @@schema("public")
}

// 確定済みバトルの陣営(チーム)。旧構造には存在しなかった概念のため、Phase1移行時は
// 旧BattleHistoryごとにself/opponent 2チーム分をバックフィル生成する(externalTeamId: null)。
//
// externalTeamIdはTikTok teamArmies[].teamIdのコピー。欠落しうる値なのでnullable/非PKにする
// (内部PKのidとは別に持つ)。
model BattleTeam {
  id              String  @id @default(cuid())
  battleHistoryId String
  externalTeamId  String?
  officialScore   String?

  battleHistory BattleHistory              @relation(fields: [battleHistoryId], references: [id], onDelete: Cascade)
  participants  BattleHistoryParticipant[]

  @@index([battleHistoryId])
  @@map("battle_teams")
  @@schema("public")
}

// 確定済みバトルの陣営1メンバー分。BattleParticipant(battle-history.ts)から
// avatarUrl(署名付きで失効する)を除いた恒久部分だけを持つ。
//
// **陣営は teamIndex(0=自分の陣営)で表す。3陣営以上のマルチバトルも丸めずに保存する。**
// side は teamIndex 導入前からある2値で、teamIndex===0 が "self"、それ以外が "opponent"。
// 既存クライアント・既存クエリの後方互換のためだけに書き続ける(判定の正は teamIndex)。
model BattleHistoryParticipant {
  id              String  @id @default(cuid())
  battleHistoryId String
  side            String // "self" | "opponent"(後方互換。正は teamIndex)
  teamIndex       Int     @default(0) // 陣営番号。0が自分の陣営
  position        Int // 陣営内の表示順(生成順をそのまま保存)
  tiktokUid       String
  score           String? // 確定時に観測できていたこのメンバーのスコア(最大30桁なのでString)。未観測ならnull

  // --- 2026-09-03拡張: コラボ相手roomごとの個別貢献者記録に対応するための列 ---
  // Expand段階につきすべてnullable。Backfillで埋め、Cutoverで読み出し側を切り替える。
  battleTeamId         String? // → BattleTeam.id。旧データはPhase1バックフィルでself/opponent 2チームを生成し紐付ける
  roomId               String? // 1配信枠(room)=1participant。旧データはbattleHistory.roomId(自room)またはtiktokUid解決先(相手room)から埋める
  isSelf               Boolean? // 旧side("self"|"opponent")から導出。正はこちら、sideは後方互換のため書き続ける
  // ハンドル・ニックネームはバトル時点で凍結するスナップショット(TikTokUserからは引かない)。
  // 2026-09の識別子統一で tiktokId / displayId / uniqueIdSnapshot の3列と nickName / nicknameSnapshot の
  // 2列をそれぞれ1列へ集約した(Expand/Cutover移行の後片付け)。
  tiktokHandleSnapshot String?
  nicknameSnapshot     String?

  officialScore     String? // teamArmies由来の公式スコア(既存scoreと役割重複だが新構造の正として保持)
  observedGiftTotal Int? // Sidestage観測Gift合計(room単位)

  captureStatus        String? // "complete" | "partial" | "unavailable"
  captureCoverage      Float? // 0.0〜1.0
  captureStartedLateMs Int?
  captureEndedEarlyMs  Int?
  captureGapMs         Int?
  monitoringStartedAt  DateTime?
  firstConnectedAt     DateTime?
  lastDisconnectedAt   DateTime?

  battleHistory BattleHistory @relation(fields: [battleHistoryId], references: [id], onDelete: Cascade)
  battleTeam    BattleTeam?   @relation(fields: [battleTeamId], references: [id], onDelete: SetNull)

  giftEvents     BattleHistoryGiftEvent[]
  itemCardEvents BattleHistoryItemCardEvent[]
  bonusMissions  BattleHistoryBonusMission[]

  @@unique([battleHistoryId, tiktokUid])
  @@index([battleTeamId])
  @@map("battle_history_participants")
  @@schema("public")
}

// 確定済みバトルの個々のギフトイベント(いつ・誰が・何を投げたか)。集約せず1ギフト=1行で
// 復元可能な形にする。通常のGift履歴とはFK/リレーションを張らず切り離す
// (sourceGiftIdは監査用の文字列参照のみ。Giftが将来変更・削除されてもこの行は影響を受けない)。
//
// 一意制約は張らない
// (1送信者が同一バトル内で複数回投げれば複数行になるのが正しい)。
model BattleHistoryGiftEvent {
  id String @id @default(cuid())

  participantId String

  occurredAt                 DateTime // Gift.receivedAtのコピー
  senderTiktokUid            String // Gift.tiktokUidのコピー(不変ID)
  // ハンドル・ニックネームは確定時点の TikTokUser から解決して凍結する
  // (Giftは90日で消えるので履歴側は自己完結が要件)。
  senderTiktokHandleSnapshot String?
  senderNicknameSnapshot     String?

  giftId           Int // TikTok側ギフト種別ID(Gift.giftIdのコピー)
  giftNameSnapshot String // Gift.giftNameのコピー(英語名)
  repeatCount      Int // Gift.repeatCountのコピー
  diamondCount     Int // Gift.diamondCountのコピー
  totalDiamonds    Int // Gift.totalDiamondsのコピー

  multiplierType  Int? // Gift.multiplierTypeのコピー
  multiplierValue Int? // Gift.multiplierValueのコピー

  // Gift.groupIdのコピー。comboの各段は saveComboGift() が「差分」を別行として残すので、
  // repeatCount は累計ではない。再生でコンボのカウントアップ(×1→×N)を復元するには、
  // どの行が同じ連打に属するかを示すこの鍵が要る。**単発ギフトにも非ゼロの値が入りうる**
  // (saveGift() も resolveGroupId() の値をそのまま保存する)ので、この列だけでcombo判定は
  // できない。再生側は anchor+送信者+giftId+groupId で束ね、"0" は単発として扱う。
  // この列より前に確定した行と、元Giftが90日保持を過ぎて消えた行はnull。
  senderGroupId String?

  sourceGiftId String // 複製元Gift.idの記録用。FK/リレーションは張らない(切り離す)

  participant BattleHistoryParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, occurredAt])
  @@index([participantId, senderTiktokUid])
  @@map("battle_history_gift_events")
  @@schema("public")
}

// 確定済みバトルのアイテムカード使用イベント(誰が・いつ・どちら側で使ったか)。
// 生観測はTiktokBattleItemUse(実装済み)。確定時にこのroomのwindow内のものだけ複製する。
model BattleHistoryItemCardEvent {
  id String @id @default(cuid())

  participantId String

  occurredAt                 DateTime // TiktokBattleItemUse.receivedAtのコピー
  cardType                   Int
  senderTiktokHandleSnapshot String?
  senderNicknameSnapshot     String?
  // TiktokBattleItemUse.senderTiktokUidのコピー。「送信者不明」を表現するため nullable のまま
  senderTiktokUid            String?

  participant BattleHistoryParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, occurredAt])
  @@map("battle_history_item_card_events")
  @@schema("public")
}

// 確定済みバトルのボーナスミッション区間。ミッション設定はバトル全体で共有だが、
// rewardSumはroom別のためparticipant単位で複数行になりうる(TiktokBattleBonusMissionと同じ理由)。
model BattleHistoryBonusMission {
  id              String @id @default(cuid())
  battleHistoryId String
  participantId   String

  targetType      Int
  progressTarget  Int
  rewardMultiple  Int
  startedAt       DateTime
  settledAt       DateTime?
  taskResult      Int?
  rewardStartedAt DateTime?
  rewardEndedAt   DateTime?
  rewardSum       Int?

  battleHistory BattleHistory            @relation(fields: [battleHistoryId], references: [id], onDelete: Cascade)
  participant   BattleHistoryParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([battleHistoryId])
  @@index([participantId])
  @@map("battle_history_bonus_missions")
  @@schema("public")
}

// 確定済みバトルのスコア曲線(バトル再生のスコアバー用)。確定時に自room・window内の
// TiktokBattleArmiesSnapshot を複製する。
//
// **participantId ではなく tiktokUid で持つ。** commitBattleSnapshot は participant を毎回削除・
// 再生成するため、participantId を持つと再確定のたびに全点を張り替えることになる。
//
// **offsetMs(windowStartからの経過ミリ秒)を持つのは再生側に時刻演算をさせないため。**
// 負値と窓超過はコミット時にクランプ済みなので、再生側は 0 <= offsetMs <= 窓長 を前提にしてよい。
// score は累積スコア(TiktokBattleArmiesSnapshot.scoreと同じ理由でString)。公式スコアは階段関数
// なので、再生側は点と点の間を補間せず「t <= elapsedMs の最後の点」を採ること。
model BattleHistoryScorePoint {
  id              String   @id @default(cuid())
  battleHistoryId String
  tiktokUid       String
  offsetMs        Int
  occurredAt      DateTime
  score           String

  battleHistory BattleHistory @relation(fields: [battleHistoryId], references: [id], onDelete: Cascade)

  @@index([battleHistoryId, offsetMs])
  @@map("battle_history_score_points")
  @@schema("public")
}

// TikTok(バトル参加者・ギフト送信者)のアバター画像を自前ストレージへ恒久保存したキャッシュ。
// TikTokの署名付きURL(数十時間で失効)への依存を切るため、圧縮のうえ1回だけダウンロードして
// Railway Bucketへ置く。roomIdを持たない(tiktokUidはグローバルに一意なので、
// 同じ人物が複数配信者に登場しても1回のダウンロードで済む)。
//
// **kindは持たない。** 2026-09の識別子統一で主体が tiktokUid(数値ID)1種類になり、
// ホスト・ギフト送信者・イベント参加者のどれで現れても1行・1オブジェクトになった。
model TiktokAvatarAsset {
  id          String   @id @default(cuid())
  tiktokUid   String
  storageKey  String
  contentType String
  byteSize    Int
  fetchedAt   DateTime @default(now()) // 7日超で再取得(avatar-storage.ts)
  updatedAt   DateTime @updatedAt

  @@unique([tiktokUid])
  @@map("tiktok_avatar_assets")
  @@schema("public")
}

// 毎朝JST6:00にevent-workerが記録する全テーブルの件数・サイズのスナップショット
// (src/lib/db-stats/collect.ts)。前日比+25%超の増分をメールへ通知する異常検知の原本データ。
// runDateはJST暦日単位で、@@uniqueが「その日は記録済みか」の判定と再起動時の二重実行防止を兼ねる。
model DbStatsSnapshot {
  id         String   @id @default(cuid())
  runDate    DateTime @db.Date
  schemaName String
  tableName  String
  rowCount   BigInt
  totalBytes BigInt
  recordedAt DateTime @default(now())

  @@unique([runDate, schemaName, tableName])
  @@index([schemaName, tableName, runDate])
  @@schema("public")
}

// ============================================================================
// event — イベント(大会)運営
//
// public のデータ(gifts / TiktokRoom / Streamer)は同じ Prisma Client から
// 直接読める。以前は列を絞った view 経由で読んでいたが、統合により不要になった。
// 参照は src/event/analytics-db.ts に集約する。
// ============================================================================

model Event {
  id               String  @id @default(cuid())
  slug             String  @unique // 公開URL /e/{slug}
  title            String
  description      String? @db.Text
  // Railway Bucket(S3互換)上のオブジェクトキー。生のURLは保存しない
  // — 読み出しのたびに src/lib/media-storage.ts が presigned GET を発行する(media-storage.ts参照)。
  coverImageKey    String?
  prizeText        String? @db.Text // 優勝賞品。公開ページでは空なら賞品セクション自体を出さない
  noticeText       String? @db.Text // 注意事項+FAQ(軽量Markdownサブセット。src/event/notice-blocks.ts が解釈する)
  ownerPrincipalId String // User.id。FKは張らない(将来 auth サービスへ切り出すため)

  format     String // "TOURNAMENT" | "DIAMOND_RACE" | "DEATHMATCH"
  entryMode  String // "SOLO" | "TEAM"
  teamPreset String @default("GENERIC") // "GENERIC" | "PREFECTURE"
  // 公開範囲がすべてを制御する。PRIVATE はオーナー以外誰にも見せない(下書き概念を統合)。
  visibility String @default("PRIVATE") // "PUBLIC" | "PRIVATE"
  status     String @default("SCHEDULED") // "SCHEDULED"|"RUNNING"|"FINISHED"|"ARCHIVED"

  // 全開催日程を覆う外枠。**sessions からの派生値**で、
  // startAt = min(sessions.startAt) / endAt = max(sessions.endAt)。
  // 集計する区間そのものは sessions(EventSession)。日程の隙間は集計に入らない。
  // 外枠を持つのは、集計対象の抽出・最終集計の締切・room 監視期限・一覧の表示が
  // 子テーブルの min/max を毎回引かずに済むようにするため。
  // **書き込みは日程と必ず同じトランザクションで行う**(イベント作成・更新APIだけ)。
  startAt DateTime
  endAt   DateTime
  // 名前空間ごとのルール。"deathmatch"(初期ライフ等、parseDeathmatchRules)と
  // "matchRules"(グローブ/ブースター等、parseMatchRules)を持つ。
  // 名前空間の追加・更新は既存キーを潰さないよう必ず `{ ...existing, <namespace>: ... }` で書く。
  rules   Json     @default("{}")

  lastAggregatedAt     DateTime?
  aggregateMs          Int? // 直近の再集計にかかった時間(SLO監視用)
  // スナップショット(EventContribution / EventStanding)を作った集計方式。
  // "FULL_PERIOD" = 開催日程の全ギフト / "BATTLE_ONLY" = 検知したバトル区間のギフトだけ。
  // null は方式を記録し始める前に最終集計を終えたイベント(FULL_PERIOD 相当)。
  // **主催者が設定する項目ではない。** aggregateEvent() が毎回書く。
  // finalizedAt が立ったイベントは再集計されないので、公開ページは format ではなく
  // この列を見て見出し・注記を決める(過去のスナップショットへ新しい説明を付けないため)。
  aggregationPolicy    String?
  // 締切(endAt + 猶予)を過ぎてからの最終集計が1回成功した時刻。
  // これが入るまでは status を FINISHED にしても集計を続ける(遅れて保存された
  // ギフトを取り込むため)。逆にこれが入ったら以後は集計しない。
  // 主催者が endAt を延ばしたら null に戻して再開させる。
  finalizedAt          DateTime?
  // startAt到来時点で参加者アイコンを自前ストレージへ1回だけスナップショットした時刻。
  // null は未到来または未実行。書き込みは avatar-snapshot.ts の1箇所だけ。
  // 個々の参加者の取得に失敗してもここは立てる(以後はライブ取得へ永続的にフォールバックする
  // fail-open方針のため)。startAtを延ばしても自動では戻さない — 延長は主催者が
  // 意図して行う操作であり、延長後も旧開始時刻のスナップショットで揃える(finalizedAtの
  // ような「再開して当然」の項目ではない)。
  avatarsSnapshottedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  sessions      EventSession[]
  teams         EventTeam[]
  participants  EventParticipant[]
  multipliers   EventMultiplier[]
  matches       EventMatch[]
  contributions EventContribution[]
  standings     EventStanding[]
  lifePoints    EventLifePoint[]
  lifeLedger    EventLifeLedger[]
  roomLeases    EventRoomLease[]

  @@index([status, endAt])
  @@index([ownerPrincipalId])
  @@schema("event")
}

// 開催日程。1つのイベントを複数の時間帯に分けて開催できる
// (例: 1日目 22:00-23:00 予選 / 2日目 22:00-23:00 決勝)。
//
// - 集計区間は日程ごとの [startAt, endAt) の半開区間。**日程の隙間は集計に入らない**
// - 日程どうしは重ならない(重なると同じギフトを二重に数える)。検証は
//   src/event/sessions.ts の normalizeSessionInputs が持つ
// - 並び順は startAt 昇順。重なりがないので sortOrder 列は持たない
// - **0件のイベントがありうる**(この機能より前に作られたもの)。その場合は
//   Event の外枠 [startAt, endAt) を1日程とみなす(resolveEventWindows)
model EventSession {
  id        String   @id @default(cuid())
  eventId   String
  name      String? // "予選" などの任意ラベル
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())

  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  matches EventMatch[]

  // EventMatch からの複合FK `(eventId, sessionId)` の参照先。
  // これがないと「他イベントの日程を指す対戦」が DB 上成立してしまう。
  @@unique([eventId, id])
  @@index([eventId, startAt])
  @@schema("event")
}

// 倍率オプション。kind を増やすだけで新しい倍率条件を足せる。
// 1件のギフトに適用される倍率は必ず1つ(src/event/scoring.ts を参照)。
model EventMultiplier {
  id        String    @id @default(cuid())
  eventId   String
  kind      String // "BATTLE"(バトル中) | "SOLO_STREAM"(枠投げ)
  factor    Decimal   @db.Decimal(6, 2) // 2.00 など
  startAt   DateTime? // 期間限定倍率。null なら常時
  endAt     DateTime?
  createdAt DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@schema("event")
}

model EventTeam {
  id             String  @id @default(cuid())
  eventId        String
  name           String
  colorHex       String?
  prefectureCode String? // teamPreset = "PREFECTURE" のとき "01".."47"
  sortOrder      Int     @default(0)

  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participants EventParticipant[]
  sides        EventMatchSide[]

  @@unique([eventId, name])
  @@unique([eventId, prefectureCode])
  @@schema("event")
}

model EventParticipant {
  id           String   @id @default(cuid())
  eventId      String
  tiktokUid    String // TikTokの不変な数値ID。登録ゲートの実在確認応答から得る(src/event/participants.ts)
  tiktokHandle String // 可変の@ハンドル。正規化済み(小文字・trim・先頭@除去)。表示・接続用のスナップショット
  roomId       String // TiktokRoom.id(論理参照)
  teamId       String?
  displayName  String // イベント内の表示名。登録時の初期値は TikTok ID で、主催者があとから編集できる
  principalId  String? // 会員登録済みなら User.id へリンク
  status       String   @default("ACTIVE") // "INVITED"|"ACTIVE"|"WITHDRAWN"|"DISQUALIFIED"
  joinedAt     DateTime @default(now())

  // 対戦カードに表示するアバターの切り出し位置・ズーム。null = 現状のデフォルト表示
  // (object-position: 50% 30%, zoom: 1)。解決は src/event/avatar-frame.ts に閉じる。
  avatarOffsetX Float? // object-position の横位置(%, 0-100)
  avatarOffsetY Float? // object-position の縦位置(%, 0-100)
  avatarZoom    Float? // 拡大率(1-3)

  event Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team  EventTeam?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sides EventMatchSideParticipant[]

  @@unique([eventId, tiktokUid])
  // 同じ room を別表記で二重登録させない = 同じギフトの二重計上を防ぐ。
  // TiktokRoom は複数 Streamer に共有されるため、tiktokUid の unique だけでは足りない。
  @@unique([eventId, roomId])
  @@schema("event")
}

// イベントのために確保した room 監視の台帳。
// TiktokRoom.monitorUntil を立てた事実をこちらで持つ。
model EventRoomLease {
  id              String    @id @default(cuid())
  eventId         String
  roomId          String
  tiktokUid       String
  tiktokHandle    String
  createdBySystem Boolean   @default(false) // イベントが room を新規作成したか
  monitorUntil    DateTime // 通常は event.endAt + 猶予
  releasedAt      DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, roomId])
  @@index([roomId, releasedAt])
  @@schema("event")
}

// 対戦(トーナメント1試合 / デスマッチの1マッチ)
model EventMatch {
  id              String @id @default(cuid())
  eventId         String
  round           Int    @default(1)
  bracketPosition Int    @default(0)
  matchType       String @default("1V1") // "1V1" | "2V2"

  // この対戦をどの開催日程で行うか。**対戦に個別の時間枠は無い**
  // (日程まるごとが監視・検知の対象。詳細は src/event/CLAUDE.md)。
  // 既存行の穴埋めは scripts/migrate-match-session.ts が db push の前に済ませる
  // (db push は「既存データのある非NULL列の追加」を実行できないため)。
  sessionId        String
  // **旧: 主催者が指定した個別の時間枠。読まない。** 書き込みだけは当面続ける
  // (割り当てた日程の [startAt, endAt) をそのまま入れる) — ローリング更新や
  // ロールバックで旧コードが同時に動いても、必須列が null で落ちないようにするため。
  // 旧世代が完全に消えた後の別リリースで、書き込みごと消す。
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  // "SCHEDULED"    まだバトルを検知していない
  // "LIVE"         検知して進行中(終了時刻がまだ確定していない暫定関連を含む)
  // "DETECTED"     検知して終了。集計で勝者を決める段階
  // "NEEDS_REVIEW" 検知したが自動確定できない(部分一致 / 2vs2 / 候補が複数 / 終了未確定のまま日程終了)。主催者の承認待ち
  // "FINISHED"     勝者が確定した
  // "NO_SHOW"      日程が終わっても検知できなかった
  // "VOID"         主催者が無効にした
  status           String    @default("SCHEDULED")

  detectedBattleId    String? // TikTok の battleId。string のまま保持する
  detectedStartAt     DateTime?
  detectedEndAt       DateTime?
  // "exact"  = 観測した room の集合が対戦カードと完全一致した
  // "partial" = 一部の room しか観測できなかった(相手が参加者でない・監視が落ちていた等)
  detectionConfidence String?
  // 検知した終了時刻の出所。"observed"(終了イベント) / "duration"(設定値から計算)。
  // **予定終了時刻へのフォールバック("scheduled")は廃止した** —
  // 実測できない終了時刻を作ると、その区間ぶんの通常ギフトまでバトル倍率と勝敗に混ざる。
  detectedEndSource   String?

  winnerSideId    String?
  // 勝敗の決め方。"AGGREGATE"(こちらの集計) / "MANUAL"(主催者が確定) / "BYE"(不戦勝) / "DRAW"(引き分け)
  winnerDecidedBy String?
  // 決着時刻。デスマッチのライフはこの順に適用する(life-points.ts)。
  // **resolveMatchSeries() が AGGREGATE 決着時も必ず書く**(旧: detectedEndAt にフォール
  // バックしていたが、勝利条件(複数バトル)対応で decidedAt を優先参照先に統一した)。
  // 主催者が確定した場合はその時刻。**null は「まだ決着していない」。**
  // updatedAt を使わない(再集計のたびに動いて適用順が不安定になる)。
  decidedAt       DateTime?

  rules Json @default("{}") // 種目別ルールと、判定時の補足情報

  event            Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // **複合FK。** sessionId 単独だと他イベントの日程を指す行が DB 上成立してしまう。
  //
  // **onDelete は Restrict。** 対戦がぶら下がった日程を消せなくすることで、
  // 「日程を全置換する古いコード(または古いイメージ)が動くと表が丸ごと消える」事故を
  // DB 側で止める。日程の削除は更新APIが 409 で先に弾き、イベントごと消すときは
  // DELETE が対戦を明示的に消してから Event を消す。
  session          EventSession                @relation(fields: [eventId, sessionId], references: [eventId, id], onDelete: Restrict)
  sides            EventMatchSide[]
  battleCandidates EventMatchBattleCandidate[]

  @@index([eventId, sessionId])
  @@index([detectedBattleId])
  @@schema("event")
}

// 対戦カード(EventMatch)に紐づく、検知した「候補バトル」1件の検知結果だけを持つ。
// 勝利条件(matchRules.winCondition)が SINGLE なら通常1件、BEST_OF_THREE ならシリーズの
// 各ゲームぶん複数件になりうる。**採点(ダイヤ集計・勝敗)はキャッシュしない** —
// 全期間再計算という既存の集計哲学(aggregate.ts)に合わせ、resolveMatchSeries() が
// 呼ばれるたびに scoreSides() で毎回計算する。詳細は src/event/CLAUDE.md。
//
// DetectedBattle への FK は張らない(roomId ごとに複数行あり、event を跨いで共有される
// 疎結合テーブルのため。battleId は文字列のまま緩く参照する)。
model EventMatchBattleCandidate {
  id       String @id @default(cuid())
  matchId  String
  battleId String

  startedAt     DateTime
  endedAt       DateTime? // null = まだ進行中(暫定候補)
  endedAtSource String? // "observed" | "duration"
  confidence    String // "exact" | "partial"

  // 同じ battleId が2つ以上の EventMatch の room 集合と完全一致した(cross-match衝突。
  // デスマッチで同じ組み合わせが複数カードにあるケースを含む)。
  // **一度 true になったら「検知をやり直す」まで sticky に true のまま**(片方のマッチが
  // confirm で open から外れても、もう片方の曖昧判定が false へ戻らないように)。
  ambiguous Boolean @default(false)

  // 主催者が「候補過多(CANDIDATES_EXCEEDED)」画面で判定対象として選んだプール。
  // selectCandidates API だけが書く。一度立てたら resolveMatchSeries() は書き換えない
  // (主催者の意図をそのまま保持する — selected と役割を分けている理由は match-results.ts 参照)。
  organizerSelected Boolean @default(false)

  // resolveMatchSeries() が毎回計算する、現在の「実効ゲーム集合(effectiveGames)」に
  // 含まれるか。loadBattleRangesByRoom() はこの列だけを見る。
  selected Boolean @default(false)

  // 主催者が「合算して1ゲームとして扱う」と判定した候補のグループ印。
  // null = 単独ゲーム(従来どおり1候補=1ゲーム)。同じ値を持つ候補群は
  // resolveMatchSeries() がスコアを合算して1ゲームとして扱う。
  //
  // **selectCandidateGroups API だけが書く。organizerSelected と対で運用する不変条件**
  // ("combinedGroupId が非null ⇒ organizerSelected も true"。void/reopen/resetCandidates は
  // 必ず両方をクリアする)。値そのものに意味はなく、サーバーが crypto.randomUUID() で
  // 発行する不透明な文字列。同じ matchId 内に複数のグループが同時に存在してよい。
  combinedGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match EventMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, battleId])
  @@index([matchId])
  @@schema("event")
}

model EventMatchSide {
  id        String  @id @default(cuid())
  matchId   String
  sideIndex Int // 0 | 1
  teamId    String?
  score     Decimal @default(0) @db.Decimal(18, 2) // 倍率適用後
  diamonds  BigInt  @default(0) // 素のダイヤ

  match        EventMatch                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team         EventTeam?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  participants EventMatchSideParticipant[]

  @@unique([matchId, sideIndex])
  @@schema("event")
}

model EventMatchSideParticipant {
  id            String @id @default(cuid())
  sideId        String
  participantId String

  side        EventMatchSide   @relation(fields: [sideId], references: [id], onDelete: Cascade)
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sideId, participantId])
  @@schema("event")
}

// デスマッチのライフポイント
model EventLifePoint {
  id           String    @id @default(cuid())
  eventId      String
  subjectType  String // "PARTICIPANT" | "TEAM"
  subjectId    String
  current      Int
  max          Int
  eliminatedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, subjectType, subjectId])
  @@schema("event")
}

// ライフ増減の履歴。後から検証できるように必ず残す。
model EventLifeLedger {
  id          String   @id @default(cuid())
  eventId     String
  subjectType String
  subjectId   String
  matchId     String?
  delta       Int
  reason      String // "MATCH_LOSS" | "MATCH_WIN" | "MATCH_DRAW"
  createdAt   DateTime @default(now())

  // イベント削除で一緒に消す。関連を張らないと履歴だけが孤児として残り続ける。
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, subjectType, subjectId])
  @@schema("event")
}

// リスナー貢献の集計スナップショット。3種のランキングをこの1テーブルで賄う。
model EventContribution {
  id                   String   @id @default(cuid())
  eventId              String
  scope                String // "EVENT" | "PARTICIPANT" | "TEAM" | "MATCH"
  scopeId              String   @default("") // participantId / teamId / matchId(EVENT のときは "")
  listenerTiktokUid    String // gifts.tiktokUid(不変ID)
  // 表示用スナップショット。null 許容(TikTokUser 行が無い / ハンドル未観測)。
  // **ニックネームとアバターURLは持たない** — 表示は resolveTikTokUserDisplay() と
  // resolveAvatarUrls() で読み取り時に解決する(改名前のハンドルをDBへ焼き付けない)。
  listenerTiktokHandle String?
  diamonds             BigInt   @default(0) // 実弾(素のダイヤ)
  points               Decimal  @default(0) @db.Decimal(18, 2) // 倍率適用後
  giftCount            Int      @default(0)
  // そのリスナーが最も多くポイントを入れた参加者。scope="EVENT" のときだけ入る
  // (PARTICIPANT / TEAM は scope 自体が答えなので null)。
  // EventStanding.subjectId と同じく **FK を張らない** — 参加者が消えても集計を壊さず、
  // 次の再集計で消える/付け替わるのに任せる。読み側は解決できなければ表示しない。
  topParticipantId     String?
  // そのリスナーがギフトを入れた参加者の人数。scope="EVENT" のときだけ意味を持つ
  participantCount     Int      @default(0)
  // 参加者ごとの内訳。scope="EVENT" のときだけ入る(形式は src/event/contribution-breakdown.ts)。
  // **null は「集計が内訳に未対応だった頃の行」**で、読み側は従来表示へフォールバックする。
  // finalizedAt が立ったイベントは再集計されないので、過去イベントの行は永久に null のまま残る。
  breakdown            Json?
  updatedAt            DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, scope, scopeId, listenerTiktokUid])
  @@index([eventId, scope, scopeId, points])
  @@index([eventId, scope, scopeId, diamonds])
  @@schema("event")
}

// 順位表スナップショット(レース・チーム戦・全体順位)
model EventStanding {
  id          String   @id @default(cuid())
  eventId     String
  subjectType String // "PARTICIPANT" | "TEAM"
  subjectId   String
  diamonds    BigInt   @default(0)
  points      Decimal  @default(0) @db.Decimal(18, 2)
  rank        Int      @default(0)
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, subjectType, subjectId])
  @@index([eventId, subjectType, rank])
  @@schema("event")
}

// TiktokBattle から取り込んだバトルの観測記録。EventMatch への照合前の生データ。
//
// **1つのバトルにつき、両サイドの room ぶんの行ができる**(両方をイベントが監視している場合)。
// `battleId` でグループ化した roomId の集合が「そのバトルの参加者」になる。
// 相手の TikTok ハンドルは payload に含まれない(anchorInfo にハンドル列が無い)ので、
// この roomId 集合による照合が唯一の確実な手段。`src/event/match-detect.ts` を参照。
model DetectedBattle {
  id       String @id @default(cuid())
  battleId String // TikTok の battleId。string のまま
  roomId   String

  startedAt          DateTime
  // startedAt が受信時刻からの推定値か。配信の途中から接続すると開始(OPEN)を取り逃す。
  startedAtEstimated Boolean  @default(true)

  endedAt     DateTime?
  durationSec Int? // BattleSetting.duration(秒)。終了を取り逃したときの推定に使う
  lastAction  Int // 最後に観測した BattleAction(4=OPEN, 5=FINISH, 6=CUT_SHORT)

  hostTiktokUids String[] @default([]) // anchorIdStr(数値文字列)
  hostDisplayIds String[] @default([]) // anchorInfo[].user.displayId(ハンドル相当・未検証)
  hostScores     Json     @default("{}") // tiktokUid -> hostScore。TikTok 側の集計値、参考のみ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // **どのマッチに割り当てたかはここに持たない。** 同じ配信者が複数のイベントに
  // 出られる以上、1つのバトルが複数イベントの対戦カードに該当しうる。
  // 割当は EventMatch.detectedBattleId 側(イベントごと)だけが持つ。

  @@unique([battleId, roomId])
  @@index([startedAt])
  @@index([roomId, startedAt])
  @@schema("event")
}
