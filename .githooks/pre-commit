#!/bin/sh
# モノレポ用 pre-commit。
# ステージされたパスを見て、変更のあったプロジェクトの検証だけを走らせる。
#
# 有効化（clone 直後に一度だけ）:
#   git config core.hooksPath .githooks
#
# 統合前は live-sidestage-analytics/.husky/pre-commit が同じ内容を実行していた。
# git の hooksPath はリポジトリに1つしか持てないため、ここへ集約している。

set -e

changed=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$changed" ] && exit 0

touched() {
  echo "$changed" | grep -q "^$1/"
}

if touched live-sidestage-analytics; then
  (
    cd live-sidestage-analytics

    echo "[pre-commit] live-sidestage-analytics: 型チェック..."
    npm run typecheck

    echo "[pre-commit] live-sidestage-analytics: ローカルテストDBを確認..."
    if ! docker compose ps db --format '{{.State}}' 2>/dev/null | grep -q "running"; then
      echo "[pre-commit] ローカルテストDBを起動します(docker compose up -d db)..."
      docker compose up -d db

      for i in $(seq 1 30); do
        if docker exec liveanalytics-local-db pg_isready -U liveanalytics >/dev/null 2>&1; then
          break
        fi
        sleep 1
      done
    fi

    if ! docker exec liveanalytics-local-db pg_isready -U liveanalytics >/dev/null 2>&1; then
      echo "[pre-commit] エラー: ローカルテストDBに接続できません。Docker Desktopが起動しているか確認してください。"
      exit 1
    fi

    echo "[pre-commit] live-sidestage-analytics: ローカルテストDBへスキーマ反映..."
    npm run db:push:local -- --skip-generate

    echo "[pre-commit] live-sidestage-analytics: テスト実行..."
    npm test
  )
fi

if touched live-sidestage-event; then
  (
    cd live-sidestage-event

    echo "[pre-commit] live-sidestage-event: 型チェック..."
    npm run typecheck

    # integration テストはローカル Postgres が要るのでここでは走らせない
    # (analytics 側の docker compose を共用する。CI と手元で明示的に実行する)。
    echo "[pre-commit] live-sidestage-event: ユニットテスト実行..."
    npm run test:unit
  )
fi
