{
  "name": "tikcaption",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest --forceExit",
    "build:windows": "electron-builder --win --x64",
    "build:installer": "electron-builder --win --x64"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.0",
    "electron-updater": "^6.8.3",
    "express": "^4.18.0",
    "socket.io": "^4.7.0",
    "tiktok-live-connector": "^2.1.1-beta1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "build": {
    "appId": "com.tikcaption.app",
    "productName": "TikCaption",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "public/**/*",
      "node_modules/**/*",
      "!node_modules/**/{CHANGELOG.md,README.md,readme.md,test,tests,__tests__,coverage}",
      "!node_modules/.cache"
    ],
    "extraResources": [
      { "from": "caption_server.py", "to": "caption_server.py" },
      { "from": "requirements.txt", "to": "requirements.txt" }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TikCaption"
    },
    "publish": {
      "provider": "generic",
      "url": "https://update.graphica-produce.com/tikcaption/win"
    }
  }
}
