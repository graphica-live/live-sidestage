# --- データベース ---
# live-sidestage-analytics と同じ PostgreSQL インスタンスを指すが、ロールとスキーマが違う。
# Prisma が管理するのは event スキーマだけ(?schema=event を必ず付ける)。
#
# Web プロセス用。NextAuth の最小 DML + event スキーマの読み書き。
DATABASE_URL="postgresql://event_web:password@host:5432/liveanalytics?schema=event"

# 集計ワーカー用。analytics 側の view を読むだけ + event スキーマの読み書き。
# worker サービスにはこちらを DATABASE_URL として設定する。
# DATABASE_URL="postgresql://event_worker:password@host:5432/liveanalytics?schema=event"

# マイグレーション専用(event スキーマの所有者)。アプリからは使わない。
# `DATABASE_URL=$DATABASE_URL_MIGRATOR npm run db:push` の形で手元から実行する。
DATABASE_URL_MIGRATOR="postgresql://event_migrator:password@host:5432/liveanalytics?schema=event"

# --- 認証 ---
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET は live-sidestage-analytics と同じ値を使う。
# 同じ Google アカウントでログインしたとき、共通の public."User".id が再利用される。
# Google Cloud Console の Authorized redirect URI に
# https://<このサービスのホスト>/api/auth/callback/google を追加すること。
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# NEXTAUTH_SECRET は analytics と別の値でよい(Cookie は共有しない)。
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-app.railway.app"

# --- analytics 連携(フェーズ2以降) ---
# analytics の内部API のベースURL。Railway private networking のホスト名。
ANALYTICS_INTERNAL_URL="http://web.railway.internal:3000"

# analytics 側の /api/internal/event-room-lease を保護する共有シークレット。
# analytics の INTERNAL_API_SECRET とは別の値にすること
# (使い回すと event が /api/internal/gift-event も叩けてしまう)。
EVENT_INTERNAL_API_SECRET="generate-with-openssl-rand-base64-32"

# --- 開発用 ---
# "1" のときだけメールアドレスだけでログインできる。本番では絶対に設定しない。
# ENABLE_DEV_LOGIN="1"
# NEXT_PUBLIC_ENABLE_DEV_LOGIN="1"
